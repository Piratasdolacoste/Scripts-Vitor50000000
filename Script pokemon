local function adminAddPokemon(playerName)
  if not adminIsLogged(playerName) then return end
  if isBusy(playerName) then
    notify("Não pode alterar o time durante uma batalha.", playerName)
    return
  end
  local pokedexId = adminSelectedPokemon[playerName]
  local def = POKEMON[pokedexId]
  local choices = adminMoveChoices[playerName] or {}
  if not def then return end
  if not playerTeams[playerName] then
    playerTeams[playerName] = {}
  end
  if #playerTeams[playerName] >= 6 then
    notify("Seu time já tem 6 Pokémon.", playerName)
    return
  end
  if #choices ~= 4 then
    notify("Escolha exatamente 4 golpes antes de adicionar.", playerName)
    return
  end

  local level = math.max(1, math.min(100, tonumber(adminLevel[playerName]) or 50))
  local p = createPokemon(pokedexId, level)
  p.moves = {}
  for i = 1, 4 do
    table.insert(p.moves, MOVES[choices[i]])
  end
  p.pp = freshPP(p.moves)

  table.insert(playerTeams[playerName], p)
  if not activeIndex[playerName] then activeIndex[playerName] = 1 end

  notify(p.name .. " Nv " .. level .. " foi adicionado ao seu time!", playerName)
  adminCloseUI(playerName)
  adminSelectedPokemon[playerName] = nil
  adminMoveChoices[playerName] = nil
  adminMoveSlot[playerName] = nil
  adminPreviewMove[playerName] = nil
  adminLevel[playerName] = nil
end


