local function ensureBattleStages(p)
  p.statStages = p.statStages or {atk=0,def=0,spa=0,spd=0,spe=0,acc=0,eva=0,crit=0}
  return p.statStages
end

local function stageMultiplier(stage)
  if stage >= 0 then return (2 + stage) / 2 end
  return 2 / (2 - stage)
end

local function accuracyStageMultiplier(stage)
  if stage >= 0 then return (3 + stage) / 3 end
  return 3 / (3 - stage)
end

local function getStageStat(p, key, base)
  local st = ensureBattleStages(p)[key] or 0
  return math.max(1, math.floor(base * stageMultiplier(st)))
end

local function resetBattleStages(p)
