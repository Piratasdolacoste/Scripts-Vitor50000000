local function xpProgressText(pokemon)
  local currentLevelXp = xpForLevel(pokemon.growth, pokemon.level)
  if pokemon.level >= 100 then
    return "XP: " .. pokemon.xp .. " (NÍVEL MÁXIMO)"
  end
  local nextXp = xpForLevel(pokemon.growth, pokemon.level + 1)
  local gainedThisLevel = math.max(0, pokemon.xp - currentLevelXp)
  local neededThisLevel = math.max(0, nextXp - currentLevelXp)
  local remaining = math.max(0, nextXp - pokemon.xp)
  return "XP: " .. pokemon.xp ..
    " | Próximo nível: " .. nextXp ..
    " | Faltam: " .. remaining ..
    " | Progresso: " .. gainedThisLevel .. "/" .. neededThisLevel
end

-- registra a vitória de `winner` sobre `defeated`; concede XP, processa
-- level up (podendo subir vários níveis de uma vez), aprendizado de
-- golpe e evolução. Devolve um texto-resumo pra mostrar no log.
local function awardEVs(winner, defeated)
  local yield=POKEMON[defeated.pokedexId] and POKEMON[defeated.pokedexId].evYield or {}
  winner.evs=winner.evs or {hp=0,atk=0,def=0,spa=0,spd=0,spe=0}
  local total=0; for _,v in pairs(winner.evs) do total=total+v end
  local evMult = ((winner.heldItem == "MachoBrace") and 2 or 1) * (winner.pokerus and 2 or 1)
  for stat,amount in pairs(yield) do
    amount = amount * evMult
    local room=math.max(0,510-total); local add=math.min(amount,room,255-(winner.evs[stat] or 0)); winner.evs[stat]=(winner.evs[stat] or 0)+add; total=total+add
  end
  winner.stats=calculateAllStats(winner.baseStats,winner.level,winner.ivs,winner.evs,winner.nature)
  winner.maxHp=winner.stats.hp; winner.hp=math.min(winner.hp,winner.maxHp)
end

local function grantXpToPokemon(playerName, mon, xpGain, msgs)
  if not mon or mon.level >= 100 or xpGain <= 0 then return end
  mon.xp = math.min(xpForLevel(mon.growth, 100), (mon.xp or xpForLevel(mon.growth, mon.level)) + xpGain)
  table.insert(msgs, mon.name .. " ganhou " .. xpGain .. " de XP!")
  local newLevel = math.min(100, levelForXp(mon.growth, mon.xp))
  while mon.level < newLevel do
    mon.level = mon.level + 1
    mon.friendship = math.min(255, (mon.friendship or 70) + 1)
    recalculateStats(mon)
    table.insert(msgs, mon.name .. " subiu para o nível " .. mon.level .. "!")
    local def = POKEMON[mon.pokedexId]
    for _, entry in ipairs((def and def.level) or {}) do
      if entry[1] == mon.level then
        local learned, msg = offerMoveLearn(playerName, mon, entry[2])
        if learned and msg then table.insert(msgs, msg) end
      end
    end
    checkEvolution(playerName, mon, msgs)
  end
end

function awardVictoryXp(playerName, winner, defeated, isTrainerBattle)
  -- Link battles entre jogadores não dão XP nem EVs em Pokémon FireRed.
  if isTrainerBattle == "pvp" then
    return "Batalha entre jogadores: sem ganho de XP/EV, como no FireRed."
  end
  local team = playerTeams[playerName] or {}
  local participants, shareHolders = {}, {}
  for _, mon in ipairs(team) do
    if mon.participated and (mon.hp or 0) > 0 then table.insert(participants, mon) end
    if mon.heldItem == "ExpShare" and (mon.hp or 0) > 0 then table.insert(shareHolders, mon) end
  end
  if #participants == 0 and winner and (winner.hp or 0) > 0 then participants[1] = winner end
  local info = GROWTH_AND_EXP[defeated.pokedexId]
  local base = math.floor(((info and info.baseExp) or 64) * defeated.level / 7)
  local msgs, gains = {}, {}
  local hasShare = #shareHolders > 0
  local participantPool = hasShare and math.floor(base / 2) or base
  local sharePool = hasShare and math.floor(base / 2) or 0
  if #participants > 0 then
    local each = math.floor(participantPool / #participants)
    for _, mon in ipairs(participants) do gains[mon] = (gains[mon] or 0) + each; awardEVs(mon, defeated) end
  end
  if hasShare then
    local eachShare = math.floor(sharePool / #shareHolders)
    for _, mon in ipairs(shareHolders) do gains[mon] = (gains[mon] or 0) + eachShare end
  end
  for mon, amount in pairs(gains) do
    if amount > 0 then
      if isTrainerBattle then amount = math.floor(amount * 1.5) end
      if mon.heldItem == "LuckyEgg" then amount = math.floor(amount * 1.5) end
      if mon.level < 100 then grantXpToPokemon(playerName, mon, amount, msgs) end
    end
  end
  for _, mon in ipairs(team) do mon.participated = nil end
  if #msgs == 0 then table.insert(msgs, "Seu time não recebeu XP (nível máximo ou sem participante elegível).") end
  return table.concat(msgs, "<br>")
end
