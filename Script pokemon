local function adminLearnset(pokedexId)
  local def = POKEMON[pokedexId]
  local result, seen = {}, {}
  if not def then return result end

  -- Golpes aprendidos por nível.
  for _, entry in ipairs(def.level or {}) do
    local moveKey = entry[2]
    if MOVES[moveKey] and not seen[moveKey] then
      seen[moveKey] = true
      table.insert(result, moveKey)
    end
  end

  -- TMs/HMs oficiais de FireRed. O arquivo do FireRed usa nomes
  -- diferentes das chaves internas de MOVES, então fazemos a conversão
  -- pelo nome exibido do golpe.
  local function normalizeMoveName(name)
    return string.lower((name or ""):gsub("[^%w]", ""))
  end

  local displayToKey = {}
  for key, move in pairs(MOVES) do
    displayToKey[normalizeMoveName(move.name or key)] = key
  end

  for _, displayName in ipairs(ADMIN_TMHMS[pokedexId] or {}) do
    local moveKey = displayToKey[normalizeMoveName(displayName)]
    if moveKey and not seen[moveKey] then
      seen[moveKey] = true
      table.insert(result, moveKey)
    end
  end

  return result
end

local function adminPokemonMatches(pokedexId, query)
  if query == "" then return true end
  local def = POKEMON[pokedexId]
  if not def then return false end
  return string.find(string.upper(def.name), string.upper(query), 1, true) ~= nil
end

local function adminFilteredPokemon(playerName)
  local list = {}
  local query = adminSearch[playerName] or ""
  for id = 1, 151 do
    if POKEMON[id] and adminPokemonMatches(id, query) then
      table.insert(list, id)
    end
  end
  return list
end

