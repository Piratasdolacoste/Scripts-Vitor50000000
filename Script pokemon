function drawPokemonViewer(playerName)
  local team = playerTeams[playerName]
  if not team or #team == 0 then
    notify("Você ainda não tem um Pokémon. Use !iniciar.", playerName)
    return
  end

  local idx = viewingIndex[playerName] or 1
  if idx > #team then idx = 1 end
  viewingIndex[playerName] = idx
  local p = team[idx]

  local header = "<p align='center'><font size='13' color='#FFFFFF'>" .. p.name ..
    " — Nv " .. p.level .. " (" .. idx .. "/" .. #team .. ")</font></p>"
  ui.addTextArea(9090, header, playerName, 180, 45, 440, 26,
    0x3B4CCA, 0x1F2A73, 1, true)

  -- O sprite fica mais baixo e separado dos painéis de informação.
  if viewerSpriteInstance[playerName] then
    tfm.exec.removeImage(viewerSpriteInstance[playerName])
  end
  viewerSpriteInstance[playerName] = tfm.exec.addImage(
    imgName(p.spriteCode), "&220", 145, 225, playerName,
    1.65, 1.65, 0, 1, 0.5, 1, false
  )

  -- Stats atuais + IVs
  local abilityDesc = getAbilityDescription(p.ability)
  local statsHtml = "<p align='left'><font size='10' color='#202020'>" ..
    "<b>STATUS ATUAIS</b><br>" ..
    "Tipo: " .. table.concat(p.types, "/") .. "<br>" ..
    "HP: " .. p.hp .. "/" .. p.maxHp .. "<br>" ..
    "Ataque: " .. p.stats.atk .. "   Defesa: " .. p.stats.def .. "<br>" ..
    "Atq.Esp: " .. p.stats.spa .. "   Def.Esp: " .. p.stats.spd .. "<br>" ..
    "Velocidade: " .. p.stats.spe .. "<br>" ..
    "Natureza: " .. p.nature .. "<br>" ..
    "Habilidade: <b>" .. (p.ability or "nenhuma") .. "</b><br>" ..
    "<font size='8'>" .. abilityDesc .. "</font><br>" ..
    "Item segurado: " .. ((p.heldItem and ITEMS[p.heldItem] and ITEMS[p.heldItem].name) or "nenhum") .. "<br><br>" ..
    "<b>IVs</b><br>" ..
    "HP " .. p.ivs.hp .. " / Atq " .. p.ivs.atk .. " / Def " .. p.ivs.def ..
      " / AtqE " .. p.ivs.spa .. " / DefE " .. p.ivs.spd .. " / Vel " .. p.ivs.spe .. "<br>" ..
    xpProgressText(p) .. "</font></p>"

  ui.addTextArea(9091, statsHtml, playerName, 385, 80, 310, 155,
    0xFFFFFF, 0x202020, 0.9, true)

  -- Golpes coloridos por tipo (cores inspiradas na interface Pokémon).
  local MOVE_TYPE_COLORS = {
    Normal="#A8A878", Fire="#F08030", Water="#6890F0", Electric="#F8D030",
    Grass="#78C850", Ice="#98D8D8", Fighting="#C03028", Poison="#A040A0",
    Ground="#E0C068", Flying="#A890F0", Psychic="#F85888", Bug="#A8B820",
    Rock="#B8A038", Ghost="#705898", Dragon="#7038F8", Dark="#705848", Steel="#B8B8D0"
  }
  -- Golpes + descrição individual.
  local movesHtml = "<p align='left'><font size='8' color='#202020'><b>GOLPES E DESCRIÇÕES</b><br>"
  for i, m in ipairs(p.moves) do
    local curPP = (p.pp and p.pp[i]) or m.pp
    local desc = translateMoveDesc(m.desc or "Sem descrição disponível.")
    local moveColor = MOVE_TYPE_COLORS[m.type] or "#444444"
    movesHtml = movesHtml ..
      "<font color='" .. moveColor .. "'><b>" .. i .. ". " .. m.name .. "</b> [" .. m.type .. "]</font> " ..
      curPP .. "/" .. m.pp .. " PP<br>" ..
      "<font size='7' color='#444444'>" .. desc .. "</font><br>"
  end
  movesHtml = movesHtml .. "</font></p>"

  ui.addTextArea(9092, movesHtml, playerName, 385, 240, 310, 105,
    0xFFFFFF, 0x202020, 0.9, true)

  if #team > 1 then
    ui.addTextArea(9093,
      "<p align='center'><font size='11' color='#FFFFFF'><a href='event:viewer_prev'>◀</a></font></p>",
      playerName, 105, 350, 55, 30, 0x707070, 0x404040, 1, true)
