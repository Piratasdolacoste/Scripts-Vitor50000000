local function getCritStage(attacker, move)
  local stage = attacker.focusEnergy and 2 or 0
  if HIGH_CRIT_MOVES[move.name] then stage = stage + 1 end
  if attacker.heldItem == "ScopeLens" then stage = stage + 1 end
  stage = stage + (ensureBattleStages(attacker).crit or 0)
  if stage > 5 then stage = 5 end
  return stage
end

