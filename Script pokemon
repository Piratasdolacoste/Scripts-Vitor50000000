    for _, bid in ipairs({9080,9081,9002,9003,9004,9005,9006,9007,9008,9009,9015,9010,9011,9012,9013,9014,9020,9021,9031,9032,9033,9034,9035,9050,9051,9052,9053,9054,9055,9056,9057}) do
      ui.removeTextArea(bid, name)
    end
    playerBattleId[name] = nil
  end
  pvpBattles[id] = nil
end

local function resolvePvpRound(id)
  local b = pvpBattles[id]
  local log = {}
  b.player.protectedThisTurn = false
  b.enemy.protectedThisTurn = false
  b.player.flinched = false
  b.enemy.flinched = false

  local actions = {
    { whoName=b.nameA, action=b.chosen[b.nameA] },
    { whoName=b.nameB, action=b.chosen[b.nameB] },
  }
  for _, a in ipairs(actions) do
    if a.action.kind == "switch" then
      a.priority = 6
    else
      local own = (a.whoName == b.nameA) and b.player or b.enemy
      a.priority = own.moves[a.action.slot].priority or 0
    end
  end
  table.sort(actions, function(a, c)
    if a.priority ~= c.priority then return a.priority > c.priority end
    local pa = (a.whoName == b.nameA) and b.player or b.enemy
    local pc = (c.whoName == b.nameA) and b.player or b.enemy
    local sa, sc = getBattleSpeed(pa,b.weather), getBattleSpeed(pc,b.weather)
    if sa == sc then return math.random() < 0.5 end
    return sa > sc
  end)

  for _, act in ipairs(actions) do
    local own = (act.whoName == b.nameA) and b.player or b.enemy
    if act.action.kind == "switch" then
      local targetSide=(act.whoName==b.nameA) and "player" or "enemy"
      local targetPokemon=(targetSide=="player") and b.player or b.enemy
      targetPokemon.switching=true
      local foe=(targetSide=="player") and b.enemy or b.player
      foe.pursuitTarget=true
      switchPvpPokemon(id, act.whoName, act.action.index, log)
      foe.pursuitTarget=false
    else
      local slot = act.action.slot
      if own.moves[slot] and (own.pp[slot] or 0) > 0 then
        local attackerKey = (act.whoName == b.nameA) and "player" or "enemy"
        local defenderKey = (attackerKey == "player") and "enemy" or "player"
        resolveMove(b, attackerKey, defenderKey, slot, log)
      end
    end
    if b.player.hp <= 0 or b.enemy.hp <= 0 then break end
  end

  if b.player.hp > 0 and b.enemy.hp > 0 then
    applyEndOfTurnStatus(b.player, log, b.weather)
    applyEndOfTurnStatus(b.enemy, log, b.weather)
    if b.player.seeded then applyLeechSeed(b.player, b.enemy, log) end
    if b.enemy.seeded then applyLeechSeed(b.enemy, b.player, log) end
    resolveFutureSight(b.player, log)
    resolveFutureSight(b.enemy, log)
    if b.weather then
      applyWeatherTick(b.player, b.weather, log)
      applyWeatherTick(b.enemy, b.weather, log)
      b.weather.turnsLeft = b.weather.turnsLeft - 1
      if b.weather.turnsLeft <= 0 then table.insert(log, "O clima voltou ao normal."); b.weather = nil end
    end
  end

  b.player.switching=false; b.enemy.switching=false
  b.chosen = {}
  b.uiPhase[b.nameA] = "menu"
  b.uiPhase[b.nameB] = "menu"

  if b.enemy.hp <= 0 then
    local xpLog = awardVictoryXp(b.nameA, b.player, b.enemy, "pvp")
    b.log = table.concat(log, "<br>") .. "<br>" .. b.enemy.name .. " (de " .. b.nameB .. ") desmaiou!<br>" .. xpLog
    if hasUsablePokemon(b.nameB) then
      b.uiPhase[b.nameB] = "switch"
      b.forcedSwitch[b.nameB] = true
      drawPvpSwitchMenu(id, b.nameB, true)
    else
      b.log = b.log .. "<br>Todos os Pokémon de " .. b.nameB .. " desmaiaram!"
      b.finished = true
      b.resultTitle = { [b.nameA]="VOCÊ VENCEU!", [b.nameB]="VOCÊ PERDEU!" }
      b.resultMessage = {
        [b.nameA] = b.player.name .. " venceu a batalha!<br>" .. xpLog,
        [b.nameB] = "Todos os seus Pokémon desmaiaram."
      }
      b.uiPhase[b.nameA] = "finished"
      b.uiPhase[b.nameB] = "finished"
    end
  elseif b.player.hp <= 0 then
    local xpLog = awardVictoryXp(b.nameB, b.enemy, b.player, "pvp")
    b.log = table.concat(log, "<br>") .. "<br>" .. b.player.name .. " (de " .. b.nameA .. ") desmaiou!<br>" .. xpLog
    if hasUsablePokemon(b.nameA) then
      b.uiPhase[b.nameA] = "switch"
      b.forcedSwitch[b.nameA] = true
      drawPvpSwitchMenu(id, b.nameA, true)
    else
      b.log = b.log .. "<br>Todos os Pokémon de " .. b.nameA .. " desmaiaram!"
      b.finished = true
      b.resultTitle = { [b.nameA]="VOCÊ PERDEU!", [b.nameB]="VOCÊ VENCEU!" }
      b.resultMessage = {
        [b.nameA] = "Todos os seus Pokémon desmaiaram.",
        [b.nameB] = b.enemy.name .. " venceu a batalha!<br>" .. xpLog
      }
      b.uiPhase[b.nameA] = "finished"
      b.uiPhase[b.nameB] = "finished"
    end
  else
    b.log = table.concat(log, "<br>")
  end

  renderPvpAll(id)
end

-- ---- roteamento de cliques ----

function eventTextAreaCallback(id, playerName, eventName)
  if eventName == "shop_close" then for _,id in ipairs({9180,9181,9182,9183,9184,9185,9186,9187,9188,9189}) do ui.removeTextArea(id,playerName) end; return end
  if eventName == "shop_prev" then drawShop(playerName,math.max(1,(shopPage[playerName] or 1)-1)); return end
  if eventName == "shop_next" then local maxPage=math.max(1,math.ceil(#SHOP_ITEMS/8)); drawShop(playerName,math.min(maxPage,(shopPage[playerName] or 1)+1)); return end
  local shopKey=eventName:match("^shop_buy_(.+)$")
  if shopKey then for _,e in ipairs(SHOP_ITEMS) do if e.key==shopKey then ensureMoney(playerName); if playerMoney[playerName]>=e.price then playerMoney[playerName]=playerMoney[playerName]-e.price; giveItem(playerName,e.key,1); notify("Comprou "..ITEMS[e.key].name.." por "..e.price.."₽.",playerName) else notify("Dinheiro insuficiente.",playerName) end; drawShop(playerName,shopPage[playerName] or 1); return end end end
  if eventName == "tmshop_close" then for _,id in ipairs({9190,9191,9192,9193,9194,9195,9196,9197,9198,9199}) do ui.removeTextArea(id,playerName) end; return end
  if eventName == "tmshop_prev" then drawTMShop(playerName,math.max(1,(tmShopPage[playerName] or 1)-1)); return end
  if eventName == "tmshop_next" then local maxPage=math.max(1,math.ceil(#TM_SHOP/8)); drawTMShop(playerName,math.min(maxPage,(tmShopPage[playerName] or 1)+1)); return end
  local tmKey=eventName:match("^tmshop_buy_([TH]M%d%d)$")
  if tmKey then local e; for _,x in ipairs(TM_SHOP) do if x.key==tmKey then e=x; break end end; if e then ensureMoney(playerName); if e.price==0 or playerMoney[playerName]>=e.price then if e.price>0 then playerMoney[playerName]=playerMoney[playerName]-e.price end; giveItem(playerName,e.key,1); notify("Comprou "..e.key.." — "..e.name..".",playerName) else notify("Dinheiro insuficiente.",playerName) end; drawTMShop(playerName,tmShopPage[playerName] or 1); return end end

  if eventName == "dex_prev" then drawPokedex(playerName, math.max(1,(dexPage[playerName] or 1)-1)); return end
  if eventName == "dex_next" then drawPokedex(playerName, math.min(151,(dexPage[playerName] or 1)+1)); return end
  if eventName == "dex_close" then closePokedex(playerName); return end
  if eventName == "trade_request_accept" then finishTrade(playerName,true); return end
  if eventName == "trade_request_reject" then finishTrade(playerName,false); return end
  if eventName == "trade_cancel" then
    local session=tradeSessions[playerName]
    if session then local other=(playerName==session.sender and session.target or session.sender); closeTradeUI(playerName); closeTradeUI(other); tradeSessions[playerName]=nil; tradeSessions[other]=nil; notify("A troca foi cancelada.",other) end
    closeTradeUI(playerName); return
  end
  local tradePick=tonumber(eventName:match("^trade_pick_(%d+)$"))
  if tradePick then
    local sess=tradeSessions[playerName]; if not sess or not playerTeams[playerName] or not playerTeams[playerName][tradePick] then return end
    if playerName==sess.sender then sess.senderIndex=tradePick else sess.targetIndex=tradePick end
    if sess.senderIndex and sess.targetIndex then drawTradeConfirm(sess.sender); drawTradeConfirm(sess.target) end
    return
  end
  if eventName == "trade_confirm" then
    local sess=tradeSessions[playerName]; if not sess then return end
    if playerName==sess.sender then sess.senderConfirm=true else sess.targetConfirm=true end
    if sess.senderConfirm and sess.targetConfirm then finishTradeSession(sess) else drawTradeConfirm(sess.sender); drawTradeConfirm(sess.target) end
    return
  end
  if eventName == "trade_accept" then finishTrade(playerName,true); return end
  if eventName == "trade_reject" then finishTrade(playerName,false); return end

  -- painel administrativo
  if eventName == "admin_close" then
    adminCloseUI(playerName)
    return
  elseif eventName == "admin_search" then
    ui.addPopup(9200, 2, "Digite o nome (ou parte do nome) do Pokémon:", playerName, 220, 145, 360, true)
    return
  elseif eventName == "admin_prev" or eventName == "admin_next" then
    local page = adminPage[playerName] or 1
    adminPage[playerName] = page + (eventName == "admin_next" and 1 or -1)
    adminDrawPokemonList(playerName)
    return
  elseif eventName == "admin_back" then
    adminSelectedPokemon[playerName] = nil
    adminMoveChoices[playerName] = nil
    adminMoveSlot[playerName] = nil
    adminPreviewMove[playerName] = nil
    adminPage[playerName] = 1
    adminDrawPokemonList(playerName)
    return
  end

  local pick = tonumber(eventName:match("^admin_pick_(%d+)$"))
  if pick then
    if not adminIsLogged(playerName) or not POKEMON[pick] then return end
    adminSelectedPokemon[playerName] = pick
    adminMoveChoices[playerName] = {}
    adminMoveSlot[playerName] = 1
    adminPreviewMove[playerName] = nil
    adminPage[playerName] = 1
    adminLevel[playerName] = 50
    adminDrawMoveMenu(playerName)
    return
  end

  local slot = tonumber(eventName:match("^admin_slot_(%d+)$"))
  if slot then
    if slot >= 1 and slot <= 4 then adminMoveSlot[playerName] = slot end
    adminDrawMoveMenu(playerName)
    return
  end

  local moveKey = eventName:match("^admin_move_(.+)$")
  if moveKey and MOVES[moveKey] then
    local pokedexId = adminSelectedPokemon[playerName]
    local valid = false
    for _, name in ipairs(adminLearnset(pokedexId)) do
      if name == moveKey then valid = true; break end
    end
    if not valid then
      notify("Esse golpe não está no learnset desse Pokémon.", playerName)
      return
    end

    adminPreviewMove[playerName] = moveKey
    local choices = adminMoveChoices[playerName] or {}
    local targetSlot = adminMoveSlot[playerName] or 1

    -- Se o golpe já estiver escolhido, não duplica.
    local existing
    for i, name in ipairs(choices) do
      if name == moveKey then existing = i; break end
    end
    if existing and existing ~= targetSlot then
      notify("Esse golpe já está escolhido no slot " .. existing .. ".", playerName)
      return
    end

    choices[targetSlot] = moveKey
    adminMoveChoices[playerName] = choices
    if targetSlot < 4 then adminMoveSlot[playerName] = targetSlot + 1 end
    adminDrawMoveMenu(playerName)
    return
  end

  if eventName == "admin_move_prev" or eventName == "admin_move_next" then
    local page = adminPage[playerName] or 1
    adminPage[playerName] = page + (eventName == "admin_move_next" and 1 or -1)
    adminDrawMoveMenu(playerName)
    return
  end

  if eventName == "admin_level" then
    ui.addPopup(9201, 2, "Digite o nível do Pokémon (1-100):", playerName, 280, 145, 240, true)
    return
  end

  if eventName == "admin_add" then
    adminAddPokemon(playerName)
    return
  end

  if eventName == "dismiss_notice" then closeNotify(playerName); return end
  if eventName == "help_close" then closeHelp(playerName); return end
  if eventName == "help_prev" then drawHelp(playerName, (helpPage[playerName] or 1) - 1); return end
  if eventName == "help_next" then drawHelp(playerName, (helpPage[playerName] or 1) + 1); return end

  if pendingEvolution[playerName] then
    if eventName == "evolution_accept" then
      finishEvolution(playerName, true)
      return
    elseif eventName == "evolution_decline" then
      finishEvolution(playerName, false)
      return
    end
    -- Enquanto a confirmação está aberta, não deixa cliques da HUD passarem.
    if not learnPrompts[playerName] then return end
  end

  -- A renomeação agora usa ui.addPopup(type 2), tratada em eventPopupAnswer.

  -- tela de ver Pokémon
  if eventName == "viewer_prev" or eventName == "viewer_next" then
    local team = playerTeams[playerName]
    local idx = viewingIndex[playerName] or 1
    idx = (eventName == "viewer_next") and (idx % #team) + 1 or ((idx - 2) % #team) + 1
    viewingIndex[playerName] = idx
    drawPokemonViewer(playerName)
    return
  elseif eventName == "viewer_rename" then
    openRenameBox(playerName)
    return
  elseif eventName == "viewer_close" then
    closePokemonViewer(playerName)
    return
  end

  if eventName == "pc_close" then closePC(playerName); return end
  if eventName == "pc_back" then drawPC(playerName); return end
  if eventName == "pc_store" then drawPCStore(playerName); return end
  local pcStoreIndex=tonumber(eventName:match("^pc_store_(%d+)$"))
  if pcStoreIndex then
    local team=playerTeams[playerName] or {}
    if #team<=1 then notify("Você precisa manter pelo menos 1 Pokémon no time.",playerName); drawPCStore(playerName); return end
    local p=team[pcStoreIndex]
    if not p then drawPCStore(playerName); return end
    playerBoxes[playerName]=playerBoxes[playerName] or {}
    table.insert(playerBoxes[playerName],p)
    table.remove(team,pcStoreIndex)
    if activeIndex[playerName] and activeIndex[playerName]>#team then activeIndex[playerName]=1 end
    notify(p.name.." foi enviado ao PC.",playerName)
    drawPC(playerName)
    return
  end
  local pcIndex=tonumber(eventName:match("^pc_take_(%d+)$"))
  if pcIndex then
    local box=playerBoxes[playerName] or {}; local p=box[pcIndex]
    if p and (#(playerTeams[playerName] or {})) < 6 then table.insert(playerTeams[playerName],p); table.remove(box,pcIndex); notify(p.name.." foi retirado do PC e entrou no seu time!",playerName); drawPC(playerName) else notify("Seu time está cheio ou esse Pokémon não existe.",playerName) end
    return
  end

  -- mochila
  if eventName == "bag_prev" then bagPage[playerName]=math.max(1,(bagPage[playerName] or 1)-1); drawBagUI(playerName); return end
  if eventName == "bag_next" then bagPage[playerName]=(bagPage[playerName] or 1)+1; drawBagUI(playerName); return end
  if eventName == "bag_close" then
    closeBagUI(playerName)
    local context = bagContext[playerName]
    bagContext[playerName] = nil
    if context == "battle" and battles[playerName] then renderButtons(playerName, battles[playerName]) end
    return
  end
  local itemKey = eventName:match("^useitem_(%w+)$")
  if itemKey and ITEMS[itemKey] then
    local context = bagContext[playerName]
    closeBagUI(playerName)
    bagContext[playerName] = nil

    if context == "battle" then
      local b = battles[playerName]
      local def = ITEMS[itemKey]
      local log = {}
      if def.kind == "ball" then
        local qty = (playerBags[playerName] and playerBags[playerName][itemKey]) or 0
        if qty <= 0 then
          notify("Você não possui " .. def.name .. ".", playerName)
          return
        end
        playerBags[playerName][itemKey] = qty - 1
        b.captureTurn = (b.captureTurn or 0) + 1
        local caught, shakes = tryCatch(playerName, b.enemy, def, b.captureTurn)
        if caught then
          if (#(playerTeams[playerName] or {})) < 6 then
            table.insert(playerTeams[playerName], b.enemy)
            markCaught(playerName, b.enemy.pokedexId)
            notify(b.enemy.name .. " foi capturado após " .. shakes .. " tremidas!", playerName)
          else
            playerBoxes[playerName]=playerBoxes[playerName] or {}
            table.insert(playerBoxes[playerName],b.enemy)
            markCaught(playerName, b.enemy.pokedexId)
            notify(b.enemy.name .. " foi enviado ao PC porque seu time está cheio!", playerName)
          end
          endBattle(playerName)
          return
        else
          local shakeText = tostring(shakes) .. "/4"
          if shakes == 0 then
            table.insert(log, b.enemy.name .. " escapou da " .. def.name .. "!")
          else
            table.insert(log, b.enemy.name .. " ficou na " .. def.name .. " por " .. shakeText .. " tremidas, mas escapou!")
          end
        end
      elseif def.kind == "heal" or def.kind == "cure" then
        table.insert(log, applyItemEffect(playerName, b.player, itemKey))
      else
        table.insert(log, def.name .. " não pode ser usado diretamente.")
      end
      -- usar item ou errar a bola consome o turno: o inimigo ataca
      if b.enemy.hp > 0 then
        local enemyMoveIndex = chooseEnemyMoveIndex(b.enemy)
        resolveMove(b, "enemy", "player", enemyMoveIndex, log)
      end
      if b.player.hp > 0 and b.enemy.hp > 0 then
        applyEndOfTurnStatus(b.player, log, b.weather); applyEndOfTurnStatus(b.enemy, log, b.weather)
        if b.player.seeded then applyLeechSeed(b.player, b.enemy, log) end
        if b.enemy.seeded then applyLeechSeed(b.enemy, b.player, log) end
      end
      b.log = table.concat(log, "<br>")
      b.phase = "menu"
      if b.player.hp <= 0 then b.log = b.log .. "<br>" .. b.player.name .. " desmaiou!" end
      renderAll(playerName)
    else
      -- uso fora de batalha: aplica no Pokémon que está sendo visto (ou o primeiro)
      local def = ITEMS[itemKey]
      if def.kind == "ball" then return end -- não tem o que capturar fora de batalha
      local idx = viewingIndex[playerName] or activeIndex[playerName] or 1
      local target = playerTeams[playerName][idx]
      if def.kind ~= "heal" and def.kind ~= "cure" then notify(def.name .. " não pode ser usado diretamente.", playerName); return end
      local msg = applyItemEffect(playerName, target, itemKey)
      notify(msg, playerName)
    end
    return
  end

  -- escolha de inicial
  local starterId = tonumber(eventName:match("^starter_(%d+)$"))
  if starterId then chooseStarter(playerName, starterId); return end

  -- escolha de quem batalha (time com mais de 1 Pokémon)
  local pickIdx = tonumber(eventName:match("^pickteam_(%d+)$"))
  if pickIdx then
    activeIndex[playerName] = pickIdx
    closeTeamPicker(playerName)
    local onReady = teamPickers[playerName]
    teamPickers[playerName] = nil
    if onReady then onReady(playerName) end
    return
  end

  -- convite de desafio
  if id == 9061 or id == 9062 then
    local challenger = pendingChallenges[playerName]
    closeChallengePrompt(playerName)
    if not challenger then return end
    pendingChallenges[playerName] = nil
    if eventName == "challenge_decline" then
      notify(playerName .. " recusou seu desafio.", challenger)
      return
    end
    if eventName == "challenge_accept" then
      if isBusy(challenger) or isBusy(playerName) then
        notify("Um dos dois já está em outra batalha.", playerName)
        return
      end
      requestActivePokemon(challenger, function(pn)
        requestActivePokemon(playerName, function(pn2)
          local battleId = startPvpBattle(challenger, playerName)
          drawPvpSprites(battleId)
          renderPvpAll(battleId)
        end)
      end)
      return
    end
  end

  if eventName == "evolution_result_continue" then
    local result = evolutionResult[playerName]
    closeEvolutionResult(playerName)
    local b = battles[playerName]
    if result and result.pokemon then
      local mon = result.pokemon
      local def = POKEMON[mon.pokedexId]
      local known = {}
      for _, move in ipairs(mon.moves or {}) do known[move.name] = true end
      for _, entry in ipairs((def and def.level) or {}) do
        if entry[1] == mon.level and MOVES[entry[2]] and not known[MOVES[entry[2]].name] then
          offerMoveLearn(playerName, mon, entry[2])
          known[MOVES[entry[2]].name] = true
        end
      end
    end
    if b then
      b.phase = b.phaseBeforeEvolution or (b.enemy and b.enemy.hp <= 0 and "finished" or "menu")
      b.phaseBeforeEvolution = nil
      if not learnPrompts[playerName] then renderAll(playerName) end
    else
      if not learnPrompts[playerName] then drawPokemonViewer(playerName) end
    end
    return
  end

  -- Resultado de uma batalha PvP: mantém a tela até o jogador continuar.
  if eventName == "battle_finish" then
    local resultId = playerBattleId[playerName]
    if resultId and pvpBattles[resultId] and pvpBattles[resultId].finished then
      endPvpBattle(resultId)
      return
    end
  end

  -- clique dentro de uma batalha PvP
  local pvpId = playerBattleId[playerName]
  if pvpId then
    local b = pvpBattles[pvpId]
    if eventName == "menu_fight" then
      b.uiPhase[playerName] = "moves"; renderPvpViewer(pvpId, playerName)
    elseif eventName == "menu_back" then
      b.uiPhase[playerName] = "menu"; renderPvpViewer(pvpId, playerName)
    elseif eventName == "menu_pokemon" then
      b.uiPhase[playerName] = "switch"
      drawPvpSwitchMenu(pvpId, playerName, false)
    elseif eventName == "menu_run" then
      endPvpBattle(pvpId)
    else
      local switchSlot = tonumber(eventName:match("^pvp_switch_(%d+)$"))
      if switchSlot then
        local team = playerTeams[playerName] or {}
        local current = (playerName == b.nameA) and b.player or b.enemy
        if team[switchSlot] and team[switchSlot].hp > 0 and team[switchSlot] ~= current then
          b.chosen[playerName] = {kind="switch", index=switchSlot}
          b.forcedSwitch[playerName] = nil
          b.uiPhase[playerName] = "menu"
          closeBattleSwitchMenu(playerName)
          renderPvpViewer(pvpId, playerName)
          if b.chosen[b.nameA] and b.chosen[b.nameB] then resolvePvpRound(pvpId) end
        end
      elseif eventName == "pvp_switch_cancel" and not b.forcedSwitch[playerName] then
        closeBattleSwitchMenu(playerName)
        b.uiPhase[playerName] = "menu"
        renderPvpViewer(pvpId, playerName)
      else
        local slot = tonumber(eventName:match("^move_(%d+)$"))
        if slot then
          local isNameA = (playerName == b.nameA)
          local ownPokemon = isNameA and b.player or b.enemy
          if ownPokemon.moves[slot] and (ownPokemon.pp[slot] or 0) > 0 then
            b.chosen[playerName] = {kind="move", slot=slot}
            renderPvpViewer(pvpId, playerName)
            if b.chosen[b.nameA] and b.chosen[b.nameB] then resolvePvpRound(pvpId) end
          end
        end
      end
    end
    return
  end

  -- tela de aprender golpe (subida de nível)
  if learnPrompts[playerName] then
    local pend = learnPrompts[playerName]
    if eventName == "learn_decline" then
      closeLearnPrompt(playerName)
      local b = battles[playerName]
      if b then b.log = pend.pokemon.name .. " não aprendeu " .. MOVES[pend.newMoveKey].name .. "."; renderAll(playerName) end
      return
    end
    local slot = tonumber(eventName:match("^forget_(%d+)$"))
    if slot then
      local forgotten = pend.pokemon.moves[slot].name
      pend.pokemon.moves[slot] = MOVES[pend.newMoveKey]
      pend.pokemon.pp[slot] = MOVES[pend.newMoveKey].pp
      if pend.tmKey and playerBags[playerName] and (playerBags[playerName][pend.tmKey] or 0)>0 then playerBags[playerName][pend.tmKey]=playerBags[playerName][pend.tmKey]-1 end
      closeLearnPrompt(playerName)
      local b = battles[playerName]
      if b then
        b.log = pend.pokemon.name .. " esqueceu " .. forgotten .. " e aprendeu " .. MOVES[pend.newMoveKey].name .. "!"
        renderAll(playerName)
      end
      return
    end
    return
  end

  -- troca de Pokémon durante batalha selvagem
  local switchIdx = tonumber(eventName:match("^battleswitch_(%d+)$"))
  if switchIdx and battles[playerName] then
    local bSwitch = battles[playerName]
    local forced = bSwitch.forcedSwitch == true
    if switchWildPokemon(playerName, switchIdx, forced) then
      bSwitch.forcedSwitch = false
    end
    return
  end
  if eventName == "battleswitch_cancel" and battles[playerName] then
    local bSwitch = battles[playerName]
    if bSwitch.forcedSwitch then
      notify("Você precisa escolher outro Pokémon.", playerName)
    else
      closeBattleSwitchMenu(playerName)
      bSwitch.phase = "menu"
      renderAll(playerName)
    end
    return
  end

  -- Tela de resultado da batalha selvagem.
  if eventName == "battle_finish" and battles[playerName] then
    local rb = battles[playerName]
    if rb.phase == "finished" then
      endBattle(playerName)
      return
    end
  end

  -- batalha selvagem
  local b = battles[playerName]
  if not b then return end
  if eventName == "menu_fight" then
    b.phase = "moves"; b.log = nil; renderAll(playerName)
  elseif eventName == "menu_back" then
    b.phase = "menu"; b.log = nil; renderAll(playerName)
  elseif eventName == "menu_bag" then
    bagContext[playerName] = "battle"
    for _, bid in ipairs({9010,9011,9012,9013,9014}) do ui.removeTextArea(bid, playerName) end
    drawBagUI(playerName)
  elseif eventName == "menu_pokemon" then
    b.phase = "switch"
    b.forcedSwitch = false
    b.log = "Escolha outro Pokémon. A troca consome o seu turno."
    drawBattleSwitchMenu(playerName, b, false)
    renderHud(playerName, b)
  elseif eventName == "menu_run" then
    if b.player.trappedTurns and b.player.trappedTurns > 0 then
      notify("Você não pode fugir enquanto " .. b.player.name .. " estiver preso!", playerName)
    elseif hasAbility(b.player,"Run Away") then
      endBattle(playerName)
    else
      b.runAttempts=(b.runAttempts or 0)+1
      local ps=getEffectiveSpeed(b.player); local es=getEffectiveSpeed(b.enemy)
      local f=math.floor((ps*32)/math.max(1,math.floor(es/4))) + 30*b.runAttempts
      if f > 255 or math.random(0,255) < math.min(255,f) then
        endBattle(playerName)
      else
        local log={b.player.name .. " tentou fugir, mas não conseguiu!"}
        local enemyMoveIndex=chooseEnemyMoveIndex(b.enemy); resolveMove(b,"enemy","player",enemyMoveIndex,log)
        b.log=table.concat(log,"<br>"); renderAll(playerName)
      end
    end
  else
    local slot = tonumber(eventName:match("^move_(%d+)$"))
    if slot and b.player.moves[slot] then
      if (b.player.pp[slot] or 0) <= 0 then
        notify("Sem PP pra usar " .. b.player.moves[slot].name .. "!", playerName)
      else
        resolveRound(playerName, slot)
      end
    end
  end
end

function eventPopupAnswer(popupId, playerName, answer)
  if popupId == 9200 and adminIsLogged(playerName) then
    adminSearch[playerName] = tostring(answer or ""):gsub("^%s+", ""):gsub("%s+$", "")
    adminPage[playerName] = 1
    adminDrawPokemonList(playerName)
    return
  end

  if popupId == 9201 and adminIsLogged(playerName) then
    local level = tonumber(tostring(answer or ""))
    if not level or level < 1 or level > 100 then
      notify("Nível inválido. Digite um número de 1 a 100.", playerName)
      return
    end
    adminLevel[playerName] = math.floor(level)
    adminDrawMoveMenu(playerName)
    return
  end

  if popupId ~= 9097 or not renamingPlayer[playerName] then return end

  renamingPlayer[playerName] = nil

  local newName = tostring(answer or ""):gsub("^%s+", ""):gsub("%s+$", "")
  newName = string.sub(newName, 1, 12)

  if newName == "" then
    notify("O nome não pode ficar vazio.", playerName)
  else
    local renamed = playerTeams[playerName][viewingIndex[playerName]]
    renamed.nickname = string.upper(newName)
    renamed.name = renamed.nickname
    notify("Pokémon renomeado para " .. string.upper(newName) .. "!", playerName)
  end

  drawPokemonViewer(playerName)
end

function eventLoop(elapsedTime, remainingTime)
end

