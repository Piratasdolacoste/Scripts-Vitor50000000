function eventChatCommand(playerName, command)
  -- Normaliza comandos para aceitar !Iniciar, !INICIAR e espaços extras.
  -- Mantém a versão original para preservar maiúsculas em nomes de jogadores.
  local rawCommand = tostring(command or "")
  rawCommand = rawCommand:gsub("^%s+", ""):gsub("%s+$", "")
  if rawCommand:sub(1, 1) == "!" then rawCommand = rawCommand:sub(2) end
  command = rawCommand:lower()

  local adminPass = rawCommand:match("^[Aa][Dd][Mm][Ii][Nn]%s+(.+)$")
  if adminPass then
    if adminPass == ADMIN_PASSWORD then
      adminLogged[playerName] = true
      notify("Login de administrador realizado. Use !adminpokemon para abrir o painel.", playerName)
    else
      adminLogged[playerName] = nil
      notify("Senha de administrador incorreta.", playerName)
    end
    return
  end

  if command == "adminpokemon" or command == "adminpoke" then
    if not adminIsLogged(playerName) then
      notify("Você precisa usar !admin 123 primeiro.", playerName)
      return
    end
    adminSearch[playerName] = ""
    adminPage[playerName] = 1
    adminDrawPokemonList(playerName)
    return
  end

  if command == "adminoff" then
    adminLogged[playerName] = nil
    adminCloseUI(playerName)
    notify("Modo administrador encerrado.", playerName)
    return
  end

  if command == "help" then
    drawHelp(playerName, 1)
    return
  end

  if command == "loja" or command == "shop" then drawShop(playerName,1); return end
  if command == "tmloja" or command == "lojatm" then drawTMShop(playerName,1); return end

  local target = rawCommand:match("^[Dd][Ee][Ss][Aa][Ff][Ii][Aa][Rr]%s+(%S+)$")
  if target then
    if target == playerName then notify("Você não pode desafiar a si mesmo.", playerName); return end
    if isBusy(playerName) then notify("Você já está em uma batalha.", playerName); return end
    if isBusy(target) then notify(target .. " já está ocupado em outra batalha.", playerName); return end
    if not hasTeam(playerName) or not hasTeam(target) then
      notify("Os dois precisam ter escolhido um Pokémon (!iniciar) antes de duelar.", playerName)
      return
    end
    pendingChallenges[target] = playerName
    notify("Desafio enviado para " .. target .. ".", playerName)
    local html = "<p align='center'><font size='11' color='#FFFFFF'>" .. playerName .. " te desafiou para uma batalha!</font></p>"
    ui.addTextArea(9060, html, target, 250, 150, 300, 40, 0x3060C0, 0x1A3A73, 0.9, true)
    ui.addTextArea(9061, "<p align='center'><font size='12' color='#FFFFFF'><a href='event:challenge_accept'>ACEITAR</a></font></p>",
      target, 250, 195, 140, 36, 0x38A838, 0x1F5C1F, 1, true)
    ui.addTextArea(9062, "<p align='center'><font size='12' color='#FFFFFF'><a href='event:challenge_decline'>RECUSAR</a></font></p>",
      target, 410, 195, 140, 36, 0xCC3333, 0x7A1F1F, 1, true)
    return
  end

  if command == "iniciar" then
    if hasTeam(playerName) then notify("Você já tem um Pokémon inicial.", playerName); return end
    drawStarterPicker(playerName)
  elseif command == "selvagem" then
    requestActivePokemon(playerName, function(pn) startWildBattle(pn) end)
  elseif command == "pokemon" then
    drawPokemonViewer(playerName)
  elseif command == "mochila" then
    bagContext[playerName] = "menu"
    drawBagUI(playerName)
  elseif command == "curar" or command == "cura" or command == "heal" then
    healTeam(playerName)
  elseif command:match("^nivel%s+[+-]%d+$") or command:match("^up%s+[+-]%d+$") or command:match("^upar%s+[+-]%d+$") then
    -- !nivel +1 / !nivel -1 sobe ou desce o Pokémon em 1 nível.
    -- O ajuste é feito passo a passo para que cada nível ganho possa
    -- disparar os golpes aprendidos naquele nível.
    local delta = tonumber(command:match("[+-]%d+"))
    local p = getActivePokemon(playerName)
    if not p then
      notify("Você ainda não tem um Pokémon ativo. Use !iniciar.", playerName)
      return
    end
    if not delta or delta == 0 then
      notify("Use !nivel +1 para subir ou !nivel -1 para descer.", playerName)
      return
    end

    local oldLevel = p.level
    local targetLevel = math.max(1, math.min(100, oldLevel + delta))
    if targetLevel == oldLevel then
      notify("O nível não pode passar de 1 a 100.", playerName)
      return
    end

    local step = targetLevel > oldLevel and 1 or -1
    local log = {}

    while p.level ~= targetLevel do
      p.level = p.level + step
      p.xp = xpForLevel(p.growth, p.level)
      recalculateStats(p)

      -- Só ao subir de nível procuramos golpes novos.
      -- Ao descer, os golpes já aprendidos não são removidos.
      if step > 0 then
        local def = POKEMON[p.pokedexId]
        for _, entry in ipairs(def.level or {}) do
          if entry[1] == p.level then
            local learned, msg = offerMoveLearn(playerName, p, entry[2])
            if learned and msg then
              table.insert(log, msg)
            end
            -- Se os 4 espaços estiverem ocupados, a tela de escolha foi aberta.
            -- Para não pular nem sobrescrever golpes de níveis seguintes, para aqui.
            if learnPrompts[playerName] then
              break
            end
          end
        end
      end
    end

    table.insert(log, 1, p.name .. " agora está no nível " .. p.level .. ".")
    checkEvolution(playerName, p, log)
    notify(table.concat(log, "<br>"), playerName)

    if not learnPrompts[playerName] and not pendingEvolution[playerName] then
      drawPokemonViewer(playerName)
    end
  elseif command:match("^nivel%s+%d+$") or command:match("^up%s+%d+$") or command:match("^upar%s+%d+$") then
    -- !nivel NUMERO define o nível exato do Pokémon para testes.
    -- Ex.: !nivel 16 -> o Pokémon passa a ser exatamente Nv 16.
    local targetLevel = tonumber(command:match("%d+"))
    local p = getActivePokemon(playerName)
    if not p then
      notify("Você ainda não tem um Pokémon ativo. Use !iniciar.", playerName)
      return
    end
    if not targetLevel or targetLevel < 1 or targetLevel > 100 then
      notify("Use !nivel 1 até !nivel 100.", playerName)
      return
    end

    local oldLevel = p.level
    p.level = targetLevel
    p.xp = xpForLevel(p.growth, p.level)
    recalculateStats(p)

    local log = {}
    if targetLevel == oldLevel then
      table.insert(log, p.name .. " já está no nível " .. targetLevel .. ".")
    else
      table.insert(log, p.name .. " agora está no nível " .. p.level .. " para teste.")
    end

    -- Ao definir um nível diretamente, verifica o learnset exatamente
    -- daquele nível. Assim !nivel 13 também testa o golpe aprendido no 13.
    local def = POKEMON[p.pokedexId]
    for _, entry in ipairs(def.level or {}) do
      if entry[1] == p.level then
        local learned, msg = offerMoveLearn(playerName, p, entry[2])
        if learned and msg then table.insert(log, msg) end
      end
    end

    checkEvolution(playerName, p, log)
    notify(table.concat(log, "<br>"), playerName)

    -- Se !pokemon já estava aberto, atualiza imediatamente os dados
    -- (nível, XP, stats e golpes). Não redesenha enquanto há uma tela
    -- de aprender golpe/evolução para não cobrir essa interface.
    if not learnPrompts[playerName] and not pendingEvolution[playerName] then
      drawPokemonViewer(playerName)
    end
  elseif command == "nivel" or command == "up" or command == "upar" then
    notify("Use !nivel NUMERO<br>!nivel +1 / !nivel -1. Ex.: !nivel 16. Para subir/descer 1 nível: !nivel +1 ou !nivel -1.", playerName)
  elseif command == "bolas" then
    -- Comando de teste: entrega uma de cada bola especial.
    for _, key in ipairs({"PokeBall","GreatBall","UltraBall","MasterBall","PremierBall","RepeatBall","TimerBall","NestBall","NetBall","DiveBall","LuxuryBall"}) do
      giveItem(playerName, key, 1)
    end
    notify("Você recebeu 1 de cada tipo de Pokébola para testar a captura.", playerName)
  elseif command:match("^dex%s*%d*$") or command:match("^pokedex%s*%d*$") then
    local arg=command:match("^%S+%s*(%d*)$")
    local wanted=tonumber(arg) or tonumber(dexPage[playerName]) or 1
    if wanted<1 then wanted=1 elseif wanted>151 then wanted=151 end
    drawPokedex(playerName,wanted)
  elseif command:match("^trocar%s+") then
    local target=rawCommand:match("^[Tt][Rr][Oo][Cc][Aa][Rr]%s+(.+)$"); if target then offerTrade(playerName,target) end
  elseif command:match("^usar%s+") then
    local stone=command:match("^usar%s+(.+)$"); for key,def in pairs(ITEMS) do if def.kind=="stone" and def.name:lower()==stone:lower() then if (playerBags[playerName] and (playerBags[playerName][key] or 0)>0) then if useStone(playerName,key) then playerBags[playerName][key]=playerBags[playerName][key]-1 end else notify("Você não possui "..def.name..".",playerName) end; break end end
  elseif command:match("^tm%s+") then
    local moveName=command:match("^tm%s+(.+)$"); teachTM(playerName,moveName)
  elseif command == "pedras" then
    for _,k in ipairs({"FireStone","WaterStone","ThunderStone","LeafStone","MoonStone","SunStone"}) do giveItem(playerName,k,1) end
    notify("Você recebeu as pedras de evolução para teste.",playerName)
  elseif command == "tms" then
    drawTMShop(playerName,tmShopPage[playerName] or 1)
  elseif command == "segurado" or command == "item" then
    local p=getActivePokemon(playerName); notify(p and (p.name .. " segura: " .. (p.heldItem or "nenhum") .. "<br>Habilidade: " .. (p.ability or "nenhuma")) or "Sem Pokémon ativo.",playerName)
  elseif command:match("^segurar%s+") then
    local key=command:match("^segurar%s+(.+)$"); local p=getActivePokemon(playerName); local found=nil; for k,d in pairs(ITEMS) do if d.kind=="held" and (d.name:lower()==key:lower() or k:lower()==key:lower()) then found=k; break end end; if p and found and (playerBags[playerName] and (playerBags[playerName][found] or 0)>0) then if p.heldItem then giveItem(playerName,p.heldItem,1) end; playerBags[playerName][found]=playerBags[playerName][found]-1; p.heldItem=found; notify(p.name.." agora segura "..ITEMS[found].name..".",playerName) else notify("Item segurável não encontrado na mochila.",playerName) end
  elseif command == "tiraritem" then
    local p=getActivePokemon(playerName); if p and p.heldItem then giveItem(playerName,p.heldItem,1); notify(p.name.." deixou de segurar "..(ITEMS[p.heldItem] and ITEMS[p.heldItem].name or p.heldItem)..".",playerName); p.heldItem=nil else notify("Seu Pokémon não está segurando nada.",playerName) end
  elseif command == "pc" then
    drawPC(playerName)
  elseif command == "pc guardar" then
    drawPCStore(playerName)
  elseif command == "xp" then
    local p = getActivePokemon(playerName)
    if not p then
      notify("Você ainda não tem um Pokémon ativo. Use !iniciar.", playerName)
      return
    end
    notify(xpProgressText(p), playerName)
  else
    notify("Comando não reconhecido: !" .. command .. "<br>Use !help para ver os comandos disponíveis.", playerName)
  end
end

