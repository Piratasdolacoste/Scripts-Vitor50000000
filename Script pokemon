local function triggerHeldBerry(p, log)
  if not p or not p.heldItem or p.hp <= 0 then return end
  local item = p.heldItem
  local cured = false
  local heal = 0
  if item == "OranBerry" and p.hp <= math.floor(p.maxHp / 2) then heal = 10 end
  if item == "SitrusBerry" and p.hp <= math.floor(p.maxHp / 2) then heal = 30 end
  local cures = {CheriBerry="Paralysis", ChestoBerry="Sleep", PechaBerry="Poison", RawstBerry="Burn", AspearBerry="Freeze", LumBerry="all"}
  local cure = cures[item]
  if cure and p.status then
    if cure == "all" or cure == p.status then cured = true; p.status=nil; p.toxicCounter=0 end
  end
  if heal > 0 then p.hp = math.min(p.maxHp, p.hp + heal); table.insert(log, p.name .. " comeu " .. item .. " e recuperou " .. heal .. " HP!"); p.consumedItem=item; p.heldItem=nil end
  if cured then table.insert(log, p.name .. " consumiu " .. item .. " e curou seu status!"); p.consumedItem=item; p.heldItem=nil end
end

