local function rollIV() return math.random(0, 31) end
local function rollIVs()
  return { hp=rollIV(), atk=rollIV(), def=rollIV(), spa=rollIV(), spd=rollIV(), spe=rollIV() }
end
local function rollNature()
  local names = {}
  for name in pairs(NATURES) do table.insert(names, name) end
  return names[math.random(1, #names)]
end
local function natureMultiplier(natureName, statKey)
  local n = NATURES[natureName]
  if not n or n.increase == n.decrease then return 1.0 end
  if statKey == n.increase then return 1.1 end
  if statKey == n.decrease then return 0.9 end
  return 1.0
end
local function calculateStat(statKey, base, iv, ev, level, natureName)
  local core = math.floor((2*base + iv + math.floor(ev/4)) * level / 100)
  if statKey == "hp" then return core + level + 10 end
  return math.floor((core + 5) * natureMultiplier(natureName, statKey))
end
local function calculateAllStats(baseStats, level, ivs, evs, nature)
  return {
    hp  = calculateStat("hp",  baseStats.hp,  ivs.hp,  evs.hp,  level, nature),
    atk = calculateStat("atk", baseStats.atk, ivs.atk, evs.atk, level, nature),
    def = calculateStat("def", baseStats.def, ivs.def, evs.def, level, nature),
    spa = calculateStat("spa", baseStats.spa, ivs.spa, evs.spa, level, nature),
    spd = calculateStat("spd", baseStats.spd, ivs.spd, evs.spd, level, nature),
    spe = calculateStat("spe", baseStats.spe, ivs.spe, evs.spe, level, nature),
  }
end

