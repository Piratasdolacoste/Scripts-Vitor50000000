      "<p align='center'><font size='11' color='#FFFFFF'><a href='event:viewer_next'>▶</a></font></p>",
      playerName, 640, 350, 55, 30, 0x707070, 0x404040, 1, true)
  end

  ui.addTextArea(9095,
    "<p align='center'><font size='10' color='#FFFFFF'><a href='event:viewer_rename'>RENOMEAR</a></font></p>",
    playerName, 180, 350, 120, 30, 0xD98C24, 0x7A4E10, 1, true)

