local function applyContactAbility(attacker, defender, move, log)
  if not attacker or not defender or not move then return end
  if move.category ~= "physical" then return end
  if hasAbility(defender, "Static") and math.random(1,100) <= 30 and not attacker.status then attacker.status="Paralysis"; table.insert(log, attacker.name .. " ficou paralisado por Static!") end
  if hasAbility(defender, "Poison Point") and math.random(1,100) <= 30 and not attacker.status then attacker.status="Poison"; table.insert(log, attacker.name .. " foi envenenado por Poison Point!") end
  if hasAbility(defender, "Flame Body") and math.random(1,100) <= 30 and not attacker.status then attacker.status="Burn"; table.insert(log, attacker.name .. " foi queimado por Flame Body!") end
  if hasAbility(defender, "Cute Charm") and attacker.gender and defender.gender and attacker.gender ~= defender.gender and attacker.gender ~= "genderless" and defender.gender ~= "genderless" and math.random(1,100) <= 30 then attacker.infatuated=true; table.insert(log, attacker.name .. " ficou apaixonado por Cute Charm!") end
  if hasAbility(attacker, "Stench") and math.random(1,100) <= 10 and not defender.actedThisTurn then defender.flinched=true; table.insert(log, defender.name .. " recuou por causa de Stench!") end
  if hasAbility(defender, "Effect Spore") and math.random(1,100) <= 30 and not attacker.status then
    local r=math.random(1,3); attacker.status=({"Sleep","Poison","Paralysis"})[r]; table.insert(log, attacker.name .. " sofreu " .. attacker.status .. " por Effect Spore!")
  end
  local contactMoves = {
    Tackle=true, Scratch=true, Pound=true, Bite=true, Crunch=true, Headbutt=true,
    ["Quick Attack"]=true, ["Body Slam"]=true, ["Double-Edge"]=true, ["Take Down"]=true,
    ["Return"]=true, ["Frustration"]=true, ["Slash"]=true, ["Fury Swipes"]=true,
    ["Hyper Fang"]=true, ["Pursuit"]=true, ["Aerial Ace"]=true, ["Wing Attack"]=true,
    ["ThunderPunch"]=true, ["Fire Punch"]=true, ["Ice Punch"]=true, ["Mach Punch"]=true,
    ["Brick Break"]=true, ["Cross Chop"]=true, ["Low Kick"]=true, ["Submission"]=true,
    ["Iron Tail"]=true, ["Metal Claw"]=true, ["Shadow Claw"]=true, ["Poison Fang"]=true,
    ["Poison Tail"]=true,
    ["Thief"]=true, ["Secret Power"]=true, ["Rock Smash"]=true, ["Strength"]=true,
    ["Double Kick"]=true, ["Jump Kick"]=true, ["High Jump Kick"]=true, ["Rollout"]=true,
    ["Flame Wheel"]=true, ["Quick Attack"]=true, ["Steel Wing"]=true
  }
  if hasAbility(defender, "Rough Skin") and contactMoves[move.name] and attacker.hp > 0 then
    local recoil = math.max(1, math.floor(attacker.maxHp / 16))
    attacker.hp = math.max(0, attacker.hp - recoil)
