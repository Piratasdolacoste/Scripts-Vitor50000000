function applyItemEffect(playerName, pokemon, itemKey)
  local def = ITEMS[itemKey]
  local msg = nil
  if def.kind == "heal" then
    local before = pokemon.hp
    pokemon.hp = math.min(pokemon.maxHp, pokemon.hp + def.amount)
    if def.cureStatus then pokemon.status = nil; pokemon.toxicCounter = 0 end
    msg = pokemon.name .. " recuperou " .. (pokemon.hp - before) .. " HP usando " .. def.name .. "."
  elseif def.kind == "cure" then
    if def.status == "all" or pokemon.status == def.status then
      pokemon.status = nil
      pokemon.toxicCounter = 0
      msg = pokemon.name .. " se curou de status com " .. def.name .. "."
    else
      msg = def.name .. " não teve efeito."
    end
  end
  if not msg then return "" .. def.name .. " não pode ser usado diretamente; equipe-o como item segurado ou use-o no menu apropriado." end
  playerBags[playerName] = playerBags[playerName] or {}
  local qty = playerBags[playerName][itemKey] or 0
  if qty <= 0 then return "Você não possui " .. def.name .. "." end
  playerBags[playerName][itemKey] = qty - 1
  return msg
end
