local function moveDamageRange(attacker, defender, move, weather)
  if not move.power then return nil end
  local physical = (move.category == "physical")
  local atk = physical and attacker.stats.atk or attacker.stats.spa
  local def = physical and defender.stats.def or defender.stats.spd
  if atk <= 0 or def <= 0 then return nil end

  if attacker.status == "Burn" and physical then
    atk = math.floor(atk * 0.5)
  end

  local base = math.floor((2 * attacker.level / 5 + 2) * move.power * atk / def / 50) + 2
  local stab = 1
  for _, t in ipairs(attacker.types) do
    if t == move.type then stab = 1.5 break end
  end

  local typeEff = getTypeEff(move.type, defender.types[1], defender.types[2])
  if typeEff == 0 then return 0, 0 end
  local weatherMult = weather and weatherDamageMultiplier(weather.kind, move.type) or 1
  local fixed = base * stab * typeEff * weatherMult
  local minDamage = math.max(1, math.floor(fixed * 0.85))
  local maxDamage = math.max(1, math.floor(fixed))
  return minDamage, maxDamage
end

