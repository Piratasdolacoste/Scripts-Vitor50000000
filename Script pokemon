-- FireRed: ao subir de nível, o HP atual aumenta pela mesma diferença do HP máximo.
-- Pokémon desmaiado continua com 0 HP; recalcular stats nunca o revive.
local function recalculateStats(pokemon)
  local oldMax = math.max(1, pokemon.maxHp or 1)
  local oldHp = math.max(0, pokemon.hp or 0)
  pokemon.stats = calculateAllStats(pokemon.baseStats, pokemon.level, pokemon.ivs, pokemon.evs, pokemon.nature)
  pokemon.maxHp = pokemon.stats.hp
  if oldHp <= 0 then pokemon.hp = 0
  else pokemon.hp = math.min(pokemon.maxHp, oldHp + (pokemon.maxHp - oldMax)) end
end

