local function canLearnTM(pokemon, moveName)
  local list = ADMIN_TMHMS[pokemon.pokedexId] or {}
  for _, n in ipairs(list) do if n == moveName then return true end end
  return false
end
local function teachTM(playerName, moveName)
  local p=getActivePokemon(playerName); local m=MOVES[moveName]
  if not p or not m then notify("Pokémon ou TM inválido.",playerName); return end
  local tmKey=nil
  for _,e in ipairs(TM_SHOP or {}) do if e.move==moveName then tmKey=e.key; break end end
  if tmKey and ((playerBags[playerName] and playerBags[playerName][tmKey]) or 0)<=0 then notify("Você não possui o TM/HM de "..m.name..". Compre em !tmloja.",playerName); return end
  if not canLearnTM(p, moveName) then notify(p.name .. " não é compatível com " .. m.name .. ".",playerName); return end
  for _, old in ipairs(p.moves or {}) do if old.name == m.name then notify(p.name .. " já conhece " .. m.name .. ".",playerName); return end end
  if #p.moves < 4 then table.insert(p.moves,m); p.pp[#p.moves]=m.pp; if tmKey then playerBags[playerName][tmKey]=playerBags[playerName][tmKey]-1 end; notify(p.name .. " aprendeu " .. m.name .. "!",playerName); return end
  learnPrompts[playerName]={pokemon=p,newMoveKey=moveName,tmKey=tmKey}; renderLearnPrompt(playerName)
end
local function useStone(playerName, stone)
  local p=getActivePokemon(playerName); if not p then return false end
  local evo=EVOLUTIONS[p.pokedexId]
  local stoneName=ITEMS[stone] and ITEMS[stone].name or stone
  local target=nil
  if evo and evo[1] then
    for _,choice in ipairs(evo) do if choice.trigger=="use-item" and choice.item==stoneName then target=choice; break end end
  elseif evo and evo.trigger=="use-item" and evo.item==stoneName then
    target=evo
  end
  if not target then notify(stoneName .. " não evolui " .. p.name .. ".",playerName); return false end
  pendingEvolution[playerName]={pokemon=p,newId=NAME_TO_ID[target.name]}
  renderEvolutionPrompt(playerName)
  return true
end
