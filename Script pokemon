local function getTypeEff(moveType, defType1, defType2, defender)
  if defender and defender.foresight and (moveType == "Normal" or moveType == "Fighting") then
    if defType1 == "Ghost" or defType2 == "Ghost" then
      -- Foresight removes Ghost immunity to Normal/Fighting.
      defType1 = (defType1 == "Ghost") and nil or defType1
      defType2 = (defType2 == "Ghost") and nil or defType2
    end
  end
  local chart = TYPE_CHART[moveType] or {}
  local m1 = chart[defType1]; if m1 == nil then m1 = 1 end
  local m2 = 1
  if defType2 then m2 = chart[defType2]; if m2 == nil then m2 = 1 end end
  return m1 * m2
end

