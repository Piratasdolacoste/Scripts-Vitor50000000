local function finishTradeSession(session)
  local sender,target=session.sender,session.target
  local a=playerTeams[sender] and playerTeams[sender][session.senderIndex]; local b=playerTeams[target] and playerTeams[target][session.targetIndex]
  if not a or not b then return end
  playerTeams[sender][session.senderIndex],playerTeams[target][session.targetIndex]=b,a
  local function tradeEvolve(owner,pokemon)
    local evo=EVOLUTIONS[pokemon.pokedexId]
    if evo and not evo[1] and evo.trigger=="trade" then pendingEvolution[owner]={pokemon=pokemon,newId=NAME_TO_ID[evo.name]}; renderEvolutionPrompt(owner) end
  end
  tradeEvolve(sender,b); tradeEvolve(target,a)
  notify("Troca concluída! Você recebeu "..b.name..".",sender); notify("Troca concluída! Você recebeu "..a.name..".",target)
  closeTradeUI(sender); closeTradeUI(target); tradeSessions[sender]=nil; tradeSessions[target]=nil
end

