  end
end


local function calculateDamage(attacker, defender, move, weather)
  local variablePowerMove = move.name == "Magnitude" or move.name == "Low Kick" or move.name == "Spit Up"
  if not move.power and not variablePowerMove then return 0, false, 1 end

  local moveType = move.type
  local power = move.power or 0
  if move.name == "Magnitude" then
    local r = math.random(1,100)
    if r <= 5 then power = 10 elseif r <= 15 then power = 30 elseif r <= 35 then power = 50
    elseif r <= 65 then power = 70 elseif r <= 85 then power = 90 elseif r <= 95 then power = 110 else power = 150 end
  elseif move.name == "Low Kick" then
    local w = (POKEDEX_INFO[defender.pokedexId] and POKEDEX_INFO[defender.pokedexId].weight or 0) / 10
    if w < 10 then power = 20 elseif w < 25 then power = 40 elseif w < 50 then power = 60
    elseif w < 100 then power = 80 elseif w < 200 then power = 100 else power = 120 end
  elseif move.name == "Spit Up" then
    power = 100 * (attacker.stockpileCount or 0)
    if power <= 0 then return 0, false, 1 end
  end
  if hasAbility(defender, "Soundproof") then
    local soundMoves = { ["Roar"]=true, ["Supersonic"]=true, ["Screech"]=true, ["Sing"]=true, ["Snore"]=true, ["Uproar"]=true, ["Hyper Voice"]=true, ["Metal Sound"]=true, ["Perish Song"]=true, ["Heal Bell"]=true, ["Grass Whistle"]=true, ["Howl"]=true }
    if soundMoves[move.name] then return 0, false, 0 end
  end

  -- Poderes dependentes de atributos do Pokémon (Gen III).
  if move.name == "Pursuit" and attacker.pursuitTarget then power = power * 2 end
  if move.name == "Return" then
    power = math.max(1, math.floor((attacker.friendship or 70) * 10 / 25))
  elseif move.name == "Frustration" then
    power = math.max(1, math.floor(((255 - (attacker.friendship or 70)) * 10) / 25))
  elseif move.name == "Hidden Power" then
    local iv = attacker.ivs or {}
    local function b0(v) return (v or 0) % 2 end
    local function b1(v) return math.floor((v or 0) / 2) % 2 end
    -- Gen III: HP, Atk, Def, Spe, SpA, SpD.
    local tBits = b0(iv.hp) + 2*b0(iv.atk) + 4*b0(iv.def) + 8*b0(iv.spe) + 16*b0(iv.spa) + 32*b0(iv.spd)
    local pBits = b1(iv.hp) + 2*b1(iv.atk) + 4*b1(iv.def) + 8*b1(iv.spe) + 16*b1(iv.spa) + 32*b1(iv.spd)
    local hpTypes = {"Fighting","Flying","Poison","Ground","Rock","Bug","Ghost","Steel","Fire","Water","Grass","Electric","Psychic","Ice","Dragon","Dark"}
    moveType = hpTypes[math.floor(tBits * 15 / 63) + 1] or "Dark"
    power = math.floor(pBits * 40 / 63) + 30
  end
  if move.name == "Weather Ball" and weather then
    power = power * 2
    if weather.kind == "rain" then moveType = "Water"
    elseif weather.kind == "sun" then moveType = "Fire"
    elseif weather.kind == "sandstorm" then moveType = "Rock"
    elseif weather.kind == "hail" then moveType = "Ice" end
  end
  if move.name == "Facade" and attacker.status then power = power * 2 end
  if move.name == "Flail" or move.name == "Reversal" then
    local ratio = attacker.hp / math.max(1, attacker.maxHp)
    if ratio <= 1/16 then power = 200 elseif ratio <= 1/8 then power = 150 elseif ratio <= 1/5 then power = 100 elseif ratio <= 1/3 then power = 80 elseif ratio <= 0.6875 then power = 40 else power = 20 end
  end
  if attacker.chargeBoost and moveType == "Electric" then power = power * 2 end
  if move.name == "Solar Beam" and weather and weather.kind ~= "sun" then power = math.floor(power / 2) end
  if move.name == "Thunder" and weather and weather.kind == "sun" then
    -- accuracy is handled before damage; power remains unchanged.
  end
  if move.name == "Present" then
    power = attacker.presentPower or 40
  end
  if move.name == "Rollout" and attacker.rolloutPower then power = attacker.rolloutPower end
  if move.name == "Fury Cutter" and attacker.furyCutterCount and attacker.furyCutterCount > 0 then
    power = math.min(160, move.power * (2 ^ attacker.furyCutterCount))
  end

  local physicalTypesGen3 = {Normal=true,Fighting=true,Flying=true,Poison=true,Ground=true,Rock=true,Bug=true,Ghost=true,Steel=true}
  local isPhysical = (move.name == "Hidden Power") and physicalTypesGen3[moveType] or (move.category == "physical")
  -- Flash Fire: depois de ativada, aumenta em 50% os golpes Fire até o Pokémon sair de campo.
  if moveType == "Fire" and attacker.flashFire then power = math.floor(power * 1.5) end
  power = math.floor(power * abilityPowerMultiplier(attacker, moveType, attacker.hp / math.max(1, attacker.maxHp)))
  power = math.floor(power * heldPowerMultiplier(attacker, moveType, isPhysical))
  local critStage = getCritStage(attacker, move)
  local crit = math.random(1, CRIT_DENOMINATORS[critStage + 1]) == 1
  if hasAbility(defender,"Shell Armor") or hasAbility(defender,"Battle Armor") then crit=false end

  -- Gen III critical hits ignore offensive/defensive stat stages.
  local atkStat
  local defStat
  if crit then
    local stagesA = ensureBattleStages(attacker)
    local stagesD = ensureBattleStages(defender)
    local atkKey = isPhysical and "atk" or "spa"
    local defKey = isPhysical and "def" or "spd"
    local atkStage = math.max(0, stagesA[atkKey] or 0)
    local defStage = math.min(0, stagesD[defKey] or 0)
    atkStat = getStageStat(attacker, atkKey, attacker.stats[atkKey])
    defStat = getStageStat(defender, defKey, defender.stats[defKey])
    -- Recompute only with the stage portions that critical hits retain.
    atkStat = math.max(1, math.floor((isPhysical and attacker.stats.atk or attacker.stats.spa) * stageMultiplier(atkStage)))
    defStat = math.max(1, math.floor((isPhysical and defender.stats.def or defender.stats.spd) * stageMultiplier(defStage)))
    defStat = math.max(1, math.floor(defStat * heldDefMultiplier(defender, isPhysical, defKey)))
  else
    atkStat = isPhysical and getStageStat(attacker, "atk", attacker.stats.atk) or getStageStat(attacker, "spa", attacker.stats.spa)
    defStat = isPhysical and getStageStat(defender, "def", defender.stats.def) or getStageStat(defender, "spd", defender.stats.spd)
    defStat = math.max(1, math.floor(defStat * heldDefMultiplier(defender, isPhysical, isPhysical and "def" or "spd")))
  end

  if attacker.status == "Burn" and isPhysical and not hasAbility(attacker, "Guts") then
    atkStat = math.max(1, math.floor(atkStat * 0.5))
  end
  if hasAbility(attacker, "Guts") and attacker.status then atkStat = math.floor(atkStat * 1.5) end
  if hasAbility(attacker, "Huge Power") and isPhysical then atkStat = atkStat * 2 end
  if hasAbility(attacker, "Hustle") and isPhysical then atkStat = math.floor(atkStat * 1.5) end
  if isPhysical and defender.status and hasAbility(defender, "Marvel Scale") then defStat = math.floor(defStat * 1.5) end
  if attacker.heldItem == "ChoiceBand" and isPhysical then atkStat = math.floor(atkStat * 1.5) end

  local levelTerm = math.floor((2 * attacker.level) / 5) + 2
  local base = math.floor(math.floor(math.floor(levelTerm * power * atkStat / math.max(1, defStat)) / 50)) + 2
  if crit then base = base * 2 end

  -- FireRed/Gen III uses a random damage factor from 85% through 100%.
  local randomFactor = math.random(85, 100)
  local damage = math.floor(base * randomFactor / 100)

  local stab = false
  for _, t in ipairs(attacker.types or {}) do
    if t == moveType then stab = true break end
  end
  if stab and move.name ~= "Struggle" then damage = math.floor(damage * 15 / 10) end

  if hasAbility(defender, "Flash Fire") and moveType == "Fire" then defender.flashFire=true; return 0, crit, 0 end
  if hasAbility(defender, "Water Absorb") and moveType == "Water" then defender.hp=math.min(defender.maxHp, defender.hp+math.max(1,math.floor(defender.maxHp/4))); return 0, crit, 0 end
  if hasAbility(defender, "Volt Absorb") and moveType == "Electric" then defender.hp=math.min(defender.maxHp, defender.hp+math.max(1,math.floor(defender.maxHp/4))); return 0, crit, 0 end
  if hasAbility(defender, "Lightning Rod") and moveType == "Electric" then changeStatStage(defender,"spa",1,{}); return 0, crit, 0 end
  if hasAbility(defender, "Levitate") and moveType == "Ground" then return 0, crit, 0 end
  local typeEff = (move.name == "Struggle") and 1 or getTypeEff(moveType, defender.types[1], defender.types[2], defender)
  if hasAbility(defender, "Wonder Guard") and typeEff <= 1 then return 0, crit, 0 end
  damage = math.floor(damage * typeEff)

  if weather and not hasAbility(attacker, "Cloud Nine") and not hasAbility(defender, "Cloud Nine") then
    local wm = weatherDamageMultiplier(weather.kind, moveType)
    damage = math.floor(damage * wm)
  end
  if moveType == "Electric" and (attacker.mudSport or defender.mudSport) then damage = math.floor(damage / 2) end
  if moveType == "Fire" and (attacker.waterSport or defender.waterSport) then damage = math.floor(damage / 2) end
  if hasAbility(defender,"Thick Fat") and (moveType=="Fire" or moveType=="Ice") then damage=math.floor(damage/2) end

  -- Em Gen III, Explosion e Self-Destruct reduzem a Defesa do alvo pela metade no cálculo.
  if move.name == "Explosion" or move.name == "Self-Destruct" then
    -- Recalcula a base com metade da Defesa, preservando o fator aleatório/STAB/tipo.
    local reducedDef = math.max(1, math.floor(defStat / 2))
    base = math.floor(math.floor(math.floor(levelTerm * power * atkStat / reducedDef) / 50)) + 2
    if crit then base = base * 2 end
    damage = math.floor(base * randomFactor / 255)
    if stab and move.name ~= "Struggle" then damage = math.floor(damage * 15 / 10) end
    damage = math.floor(damage * typeEff)
    if weather and not hasAbility(attacker, "Cloud Nine") and not hasAbility(defender, "Cloud Nine") then damage = math.floor(damage * weatherDamageMultiplier(weather.kind, moveType)) end
    if moveType == "Electric" and (attacker.mudSport or defender.mudSport) then damage = math.floor(damage / 2) end
    if moveType == "Fire" and (attacker.waterSport or defender.waterSport) then damage = math.floor(damage / 2) end
    if hasAbility(defender,"Thick Fat") and (moveType=="Fire" or moveType=="Ice") then damage=math.floor(damage/2) end
  end

  -- Critical hits bypass Reflect/Light Screen in Gen III; apply these only once.
  if not crit then
    if isPhysical and (defender.reflectTurns or 0) > 0 then damage = math.floor(damage / 2) end
    if not isPhysical and (defender.lightScreenTurns or 0) > 0 then damage = math.floor(damage / 2) end
  end

  if typeEff ~= 0 then damage = math.max(1, damage) else damage = 0 end
  if attacker.chargeBoost and moveType == "Electric" then attacker.chargeBoost = false end
  return damage, crit, typeEff
end

local function getEffectiveSpeed(p)
  local spd = getStageStat(p, "spe", p.stats.spe)
  if p.status == "Paralysis" then spd = math.floor(spd * STATUS.Paralysis.speedMod()) end
  if p.heldItem == "MachoBrace" then spd = math.max(1, math.floor(spd / 2)) end
  if p.heldItem == "QuickClaw" and math.random(1,100) <= 20 then spd = spd * 1000 end
  return spd
end
local function getBattleSpeed(p, weather)
  local spd=getEffectiveSpeed(p)
  if weather and weather.kind == "rain" and hasAbility(p,"Swift Swim") then spd=spd*2 end
  if weather and weather.kind == "sun" and hasAbility(p,"Chlorophyll") then spd=spd*2 end
  if weather and weather.kind == "sandstorm" and hasAbility(p,"Sand Veil") then spd=spd end
  return spd
end


