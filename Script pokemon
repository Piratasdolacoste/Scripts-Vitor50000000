  if b.finished and b.uiPhase[viewerName] == "finished" then
    view.log = b.log
    renderHud(viewerName, view)
    drawBattleResult(viewerName, b.resultTitle[viewerName], b.resultMessage[viewerName])
    return
  end
  if b.chosen[viewerName] then
    view.log = "Ação escolhida! Aguardando o oponente..."
    renderHud(viewerName, view)
    for _, bid in ipairs({9010,9011,9012,9013,9014,9050,9051,9052,9053,9054,9055,9056,9057}) do ui.removeTextArea(bid, viewerName) end
