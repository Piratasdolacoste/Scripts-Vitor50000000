local function abilitySlug(name)
  return tostring(name or ""):lower():gsub("[^%w]", "")
end

hasAbility = function(p, name)
  return p and abilitySlug(p.ability) == abilitySlug(name) and not p.abilitySuppressed
end

-- Spikes é armazenado pelo lado que recebe o dano, não pelo lado que usou o golpe.
local function ensureSpikes(b)
  if type(b.spikes) ~= "table" then
    local old = tonumber(b.spikes) or 0
    b.spikes = { player = old, enemy = old }
  end
  b.spikes.player = math.max(0, math.min(3, tonumber(b.spikes.player) or 0))
  b.spikes.enemy = math.max(0, math.min(3, tonumber(b.spikes.enemy) or 0))
  return b.spikes
end

local function applySpikesOnEntry(b, side, pokemon, log)
  if not b or not pokemon or pokemon.hp <= 0 then return false end
  local layers = ensureSpikes(b)[side] or 0
  if layers <= 0 then return false end
  local types = pokemon.types or {}
  if types[1] == "Flying" or types[2] == "Flying" or hasAbility(pokemon, "Levitate") then
    table.insert(log, pokemon.name .. " não foi afetado por Spikes!")
    return false
  end
  local divisor = layers == 1 and 8 or (layers == 2 and 6 or 4)
  local damage = math.max(1, math.floor((pokemon.maxHp or pokemon.stats.hp or 1) / divisor))
  damage = math.min(pokemon.hp, damage)
  pokemon.hp = math.max(0, pokemon.hp - damage)
  table.insert(log, "Spikes feriu " .. pokemon.name .. " em " .. damage .. " HP (" .. layers .. " camada(s))!")
  if pokemon.hp <= 0 then table.insert(log, pokemon.name .. " desmaiou ao entrar por causa de Spikes!") end
  return pokemon.hp <= 0
end

local function abilityPowerMultiplier(p, moveType, hpFraction)
  if hasAbility(p, "Overgrow") and moveType == "Grass" and hpFraction <= 1/3 then return 1.5 end
  if hasAbility(p, "Blaze") and moveType == "Fire" and hpFraction <= 1/3 then return 1.5 end
  if hasAbility(p, "Torrent") and moveType == "Water" and hpFraction <= 1/3 then return 1.5 end
  if hasAbility(p, "Swarm") and moveType == "Bug" and hpFraction <= 1/3 then return 1.5 end
  return 1
end

