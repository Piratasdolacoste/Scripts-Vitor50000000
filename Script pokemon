local function switchWildPokemon(playerName, newIndex, forced)
  local b = battles[playerName]
  local team = playerTeams[playerName] or {}
  local newPokemon = team[newIndex]
  if not b or not newPokemon then return false end
  if newPokemon.hp <= 0 then
    notify("Esse Pokémon está desmaiado.", playerName)
    return false
  end
  if newIndex == activeIndex[playerName] then
    notify("Esse Pokémon já está em batalha.", playerName)
    return false
  end
  if b.player.permanentTrap then notify("Você não pode trocar: seu Pokémon está preso!", playerName); return false end
  if hasAbility(b.enemy,"Arena Trap") and newPokemon.types[1] ~= "Flying" and newPokemon.types[2] ~= "Flying" and not hasAbility(newPokemon,"Levitate") then
    notify("Arena Trap impede a troca!", playerName); return false
  end
  if hasAbility(b.enemy,"Magnet Pull") and (newPokemon.types[1]=="Steel" or newPokemon.types[2]=="Steel") then
    notify("Magnet Pull impede a troca!", playerName); return false
  end

  local oldPokemon = b.player
  oldPokemon.flashFire = nil -- o bônus de Flash Fire termina ao sair de campo
  restoreTransformedPokemon(oldPokemon)
  oldPokemon.seeded = false
  oldPokemon.permanentTrap = false
  oldPokemon.trappedTurns = 0
  oldPokemon.trappedBy = nil
  oldPokemon.protectedThisTurn = false
  resetBattleStages(newPokemon)
  newPokemon.flashFire = nil
  activeIndex[playerName] = newIndex
  b.player = newPokemon
  newPokemon.protectedThisTurn = false
  newPokemon.protectStreak = 0
  pendingBattleSwitch[playerName] = nil
  closeBattleSwitchMenu(playerName)
  drawSprites(playerName, b)

  local log = {"Vai, " .. newPokemon.name .. "!"}
  applySpikesOnEntry(b, "player", newPokemon, log)
  if hasAbility(oldPokemon, "Natural Cure") and oldPokemon.status then oldPokemon.status=nil; oldPokemon.toxicCounter=0; table.insert(log, oldPokemon.name .. " foi curado por Natural Cure!") end
  if newPokemon.hp > 0 then applyAbilityOnSwitch(newPokemon, b.enemy, log) end

  if newPokemon.hp <= 0 then
    b.phase = "switch"; b.forcedSwitch = true
    drawBattleSwitchMenu(playerName, b, true)
  elseif not forced and b.enemy.hp > 0 then
    local enemyMoveIndex = chooseEnemyMoveIndex(b.enemy)
    b.player.protectedThisTurn = false
    b.enemy.protectedThisTurn = false
    resolveMove(b, "enemy", "player", enemyMoveIndex, log)
    if b.player.hp > 0 and b.enemy.hp > 0 then
      applyEndOfTurnStatus(b.player, log, b.weather)
      applyEndOfTurnStatus(b.enemy, log, b.weather)
      if b.player.seeded then applyLeechSeed(b.player, b.enemy, log) end
      if b.enemy.seeded then applyLeechSeed(b.enemy, b.player, log) end
      if b.weather then
        applyWeatherTick(b.player, b.weather, log)
        applyWeatherTick(b.enemy, b.weather, log)
        b.weather.turnsLeft = b.weather.turnsLeft - 1
        if b.weather.turnsLeft <= 0 then table.insert(log, "O clima voltou ao normal."); b.weather = nil end
      end
    end
  end

  b.log = table.concat(log, "<br>")
  b.phase = "menu"
  if b.player.hp <= 0 then
    b.log = b.log .. "<br>" .. b.player.name .. " desmaiou!"
    if hasUsablePokemon(playerName) then
      b.phase = "switch"
      drawBattleSwitchMenu(playerName, b, true)
    else
      b.log = b.log .. "<br>Todos os seus Pokémon desmaiaram!"
      endBattle(playerName)
      return true
    end
  end
  renderAll(playerName)
  return true
end

