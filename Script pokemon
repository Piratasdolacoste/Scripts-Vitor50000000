  resetBattleStages(pokemonA)
  resetBattleStages(pokemonB)
  pvpBattles[id] = {
    nameA = nameA, nameB = nameB, player = pokemonA, enemy = pokemonB,
    activeA = activeIndex[nameA], activeB = activeIndex[nameB],
    weather = nil, log = nil, chosen = {}, uiPhase = { [nameA]="menu", [nameB]="menu" }, forcedSwitch = {}, spikes = { player = 0, enemy = 0 },
  }
  playerBattleId[nameA] = id
  playerBattleId[nameB] = id
  return id
end

local function perspectiveOf(b, viewerName)
  if viewerName == b.nameA then
    return { player=b.player, enemy=b.enemy, weather=b.weather, log=b.log, phase=b.uiPhase[viewerName] }
  else
    return { player=b.enemy, enemy=b.player, weather=b.weather, log=b.log, phase=b.uiPhase[viewerName] }
  end
end

local function renderPvpViewer(id, viewerName)
  local b = pvpBattles[id]
