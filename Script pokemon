local function rollGender(pokedexId)
  local ratio = GENDER_RATIO[pokedexId]
  if ratio == nil then return "genderless" end
  if ratio <= 0 then return "male" end
  if ratio >= 100 then return "female" end
  return (math.random() * 100 < ratio) and "female" or "male"
end

