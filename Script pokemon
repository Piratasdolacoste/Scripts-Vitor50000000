applyEndOfTurnStatus = function(p, log, weather)
  if p.hp <= 0 then return end

  if p.status == "Poison" then
    local d = math.max(1, math.floor(p.maxHp / 8))
    p.hp = math.max(0, p.hp - d)
    table.insert(log, p.name .. " sofreu " .. d .. " de dano por veneno.")
  elseif p.status == "Toxic" then
    p.toxicCounter = math.max(1, (p.toxicCounter or 0) + 1)
    local d = math.max(1, math.floor(p.maxHp * p.toxicCounter / 16))
    p.hp = math.max(0, p.hp - d)
    table.insert(log, p.name .. " sofreu " .. d .. " de dano por veneno grave!")
  elseif p.status == "Burn" then
    local d = math.max(1, math.floor(p.maxHp / 8))
    p.hp = math.max(0, p.hp - d)
    table.insert(log, p.name .. " sofreu " .. d .. " de dano por queimadura.")
  end

  if p.hp <= 0 then return end

  if p.heldItem == "Leftovers" then
    local heal=math.max(1,math.floor(p.maxHp/16)); local before=p.hp; p.hp=math.min(p.maxHp,p.hp+heal); table.insert(log,p.name.." recuperou "..(p.hp-before).." HP com Leftovers!")
  end
  if hasAbility(p, "Speed Boost") then changeStatStage(p, "spe", 1, log) end
  if hasAbility(p, "Shed Skin") and p.status and math.random(1,100) <= 30 then
    table.insert(log, p.name .. " curou " .. p.status .. " com Shed Skin!")
    p.status=nil; p.toxicCounter=0; p.sleepTurns=0
  end
  if hasAbility(p, "Rain Dish") and weather and weather.kind == "rain" then
    local before=p.hp; p.hp=math.min(p.maxHp,p.hp+math.max(1,math.floor(p.maxHp/16)))
    if p.hp>before then table.insert(log,p.name .. " recuperou HP com Rain Dish!") end
  end
  triggerHeldBerry(p, log)

  if p.trappedTurns and p.trappedTurns > 0 and not p.permanentTrap then
    local d = math.max(1, math.floor(p.maxHp / 16))
    p.hp = math.max(0, p.hp - d)
    p.trappedTurns = p.trappedTurns - 1
    table.insert(log, p.name .. " sofreu " .. d .. " de dano por estar preso!")
    if p.trappedTurns <= 0 then p.trappedBy = nil; table.insert(log, p.name .. " se libertou do aprisionamento!") end
  end
  if p.hp <= 0 then return end

  if p.nightmare and p.status == "Sleep" then
    local d = math.max(1, math.floor(p.maxHp / 4))
    p.hp = math.max(0, p.hp - d)
    table.insert(log, p.name .. " sofreu " .. d .. " de dano pelo Nightmare!")
  elseif p.nightmare then
    p.nightmare = false
  end
  if p.ingrain and p.hp > 0 then
    local heal = math.max(1, math.floor(p.maxHp / 16))
    local before = p.hp
    p.hp = math.min(p.maxHp, p.hp + heal)
    table.insert(log, p.name .. " recuperou " .. (p.hp-before) .. " HP com Ingrain!")
  end
  if p.yawnTurns and p.yawnTurns > 0 then
    p.yawnTurns = p.yawnTurns - 1
    if p.yawnTurns <= 0 and not p.status then
      p.status = "Sleep"; p.sleepTurns = math.random(1,4)
      table.insert(log, p.name .. " adormeceu por causa de Yawn!")
    end
  end
  if p.perishCount then
    p.perishCount = p.perishCount - 1
    table.insert(log, p.name .. " está sob o efeito de Perish Song: " .. p.perishCount .. ".")
    if p.perishCount <= 0 then p.hp = 0; table.insert(log, p.name .. " desmaiou por Perish Song!") end
  end
  if p.reflectTurns and p.reflectTurns > 0 then p.reflectTurns = p.reflectTurns - 1 end
  if p.lightScreenTurns and p.lightScreenTurns > 0 then p.lightScreenTurns = p.lightScreenTurns - 1 end
  if p.safeguardTurns and p.safeguardTurns > 0 then p.safeguardTurns = p.safeguardTurns - 1 end
  if p.mistTurns and p.mistTurns > 0 then p.mistTurns = p.mistTurns - 1 end
  if p.tauntTurns and p.tauntTurns > 0 then p.tauntTurns = p.tauntTurns - 1 end
  if p.grudge and p.hp <= 0 then p.grudge = false end
end

applyLeechSeed = function(seededPokemon, healedPokemon, log)
  if not seededPokemon.seeded or seededPokemon.hp <= 0 then return end
  local dmg = math.max(1, math.floor(seededPokemon.maxHp / 8))
  seededPokemon.hp = math.max(0, seededPokemon.hp - dmg)
  local healed = math.min(healedPokemon.maxHp - healedPokemon.hp, dmg)
  healedPokemon.hp = healedPokemon.hp + healed
  table.insert(log, seededPokemon.name .. " teve HP drenado pela Leech Seed!")
end

applyWeatherTick = function(p, weather, log)
  if not weather or p.hp <= 0 then return end
  if weather.kind ~= "sandstorm" and weather.kind ~= "hail" then return end
  if weatherImmune(weather.kind, p.types) then return end
  local dmg = math.max(1, math.floor(p.maxHp / 16))
  p.hp = math.max(0, p.hp - dmg)
  table.insert(log, p.name .. " foi ferido pelo clima! (" .. dmg .. ")")
end

local function rollMultiHitCount(move)
  if move.name == "Double Kick" or move.name == "Twineedle" or move.name == "Double Hit" or move.name == "Bonemerang" then return 2 end
  local r = math.random(1, 100)
  if r <= 37 then return 2 elseif r <= 74 then return 3 elseif r <= 87 then return 4 else return 5 end
end

local function getFixedDamage(attacker, defender, move)
  local fixedTypeMoves = {
    Guillotine=true, ["Horn Drill"]=true, Fissure=true, ["Sheer Cold"]=true,
    ["Sonic Boom"]=true, ["Dragon Rage"]=true, ["Seismic Toss"]=true,
    ["Night Shade"]=true, Psywave=true, Counter=true, ["Mirror Coat"]=true,
  }
  if fixedTypeMoves[move.name] then
    local eff = getTypeEff(move.type, defender.types[1], defender.types[2], defender)
    if eff == 0 or (move.type == "Ground" and hasAbility(defender, "Levitate")) then return 0 end
  end
  if move.name == "Guillotine" or move.name == "Horn Drill" or move.name == "Fissure" or move.name == "Sheer Cold" then
    if hasAbility(defender, "Sturdy") or attacker.level < defender.level then return 0 end
    return defender.hp
  end
  if move.name == "Endeavor" then return math.max(0, defender.hp - attacker.hp) end
  if move.name == "Super Fang" then return math.max(1, math.floor(defender.hp/2)) end
  if move.name == "Sonic Boom" then return 20 end
  if move.name == "Dragon Rage" then return 40 end
  if move.name == "Seismic Toss" or move.name == "Night Shade" then return attacker.level end
  if move.name == "Super Fang" then return math.max(1, math.floor(defender.hp / 2)) end
  if move.name == "Endeavor" then return math.max(0, defender.hp - attacker.hp) end
  if move.name == "Psywave" then return math.random(attacker.level, math.max(attacker.level, math.floor(attacker.level * 1.5))) end
  if move.name == "Counter" then
    if attacker.lastDamageCategory == "physical" and attacker.lastDamageTaken > 0 then return attacker.lastDamageTaken * 2 end
    return 0
  end
  if move.name == "Mirror Coat" then
    if attacker.lastDamageCategory == "special" and attacker.lastDamageTaken > 0 then return attacker.lastDamageTaken * 2 end
    return 0
  end
  return nil
end

restoreTransformedPokemon = function(p)
  if not p or not p.transformed then return end
  p.name = p.transformOriginalName
  p.types = p.transformOriginalTypes
  p.baseStats = p.transformOriginalBaseStats
  p.stats = p.transformOriginalStats
  p.moves = p.transformOriginalMoves
  p.pp = p.transformOriginalPP
  p.spriteCode = p.transformOriginalSpriteCode
  p.transformed = false
  p.transformOriginalName = nil
  p.transformOriginalTypes = nil
  p.transformOriginalBaseStats = nil
  p.transformOriginalStats = nil
  p.transformOriginalMoves = nil
  p.transformOriginalPP = nil
  p.transformOriginalSpriteCode = nil
end

local function cloneMoveList(moves)
  local out = {}
  for i, m in ipairs(moves or {}) do out[i] = m end
  return out
end

local function executeTransform(attacker, defender, log)
  if attacker.transformed then
    table.insert(log, attacker.name .. " já está transformado!")
    return
  end
  attacker.transformOriginalName = attacker.name
  attacker.transformOriginalTypes = attacker.types
  attacker.transformOriginalBaseStats = attacker.baseStats
  attacker.transformOriginalStats = attacker.stats
  attacker.transformOriginalMoves = attacker.moves
  attacker.transformOriginalPP = attacker.pp
  attacker.transformOriginalSpriteCode = attacker.spriteCode
  attacker.name = defender.name
  attacker.types = defender.types
  attacker.baseStats = defender.baseStats
  attacker.stats = defender.stats
  attacker.moves = cloneMoveList(defender.moves)
  attacker.pp = {}
  for i, m in ipairs(attacker.moves) do attacker.pp[i] = math.min(5, m.pp) end
  attacker.spriteCode = defender.spriteCode
  attacker.transformed = true
  table.insert(log, "" .. attacker.transformOriginalName .. " se transformou em " .. defender.name .. "!")
end

local function performFutureSight(b, attackerKey, defenderKey, move, log)
  local attacker, defender = b[attackerKey], b[defenderKey]
  defender.futureSight = {
    damage = move.power,
    attacker = attacker,
    turns = 2,
    type = move.type,
  }
  table.insert(log, attacker.name .. " previu um ataque futuro!")
end

local function resolveFutureSight(p, log)
  if not p.futureSight then return end
  p.futureSight.turns = p.futureSight.turns - 1
  if p.futureSight.turns > 0 then return end
  local fs = p.futureSight
  p.futureSight = nil
  local target = p
  local source = fs.attacker
  local fakeMove = MOVES["FutureSight"]
  if fakeMove then
    local dmg = calculateDamage(source, target, fakeMove, nil)
    target.hp = math.max(0, target.hp - dmg)
    table.insert(log, "O Future Sight atingiu " .. target.name .. "! Dano: " .. dmg)
  end
end

local function moveKeyByDisplayName(name)
  for key,m in pairs(MOVES) do if m.name == name then return key end end
  return name:gsub("%s+", "")
end

chooseEnemyMoveIndex = function(pokemon)
  local usable = {}
  for i, move in ipairs(pokemon.moves or {}) do
    if move.name == "Struggle" or not pokemon.pp or (pokemon.pp[i] or 0) > 0 then table.insert(usable, i) end
  end
  if #usable == 0 then
    local struggleKey = moveKeyByDisplayName and moveKeyByDisplayName("Struggle") or "Struggle"
    local struggle = MOVES and (MOVES[struggleKey] or MOVES.Struggle)
    if struggle then
      pokemon.moves = {struggle}; pokemon.pp = {struggle.pp}; return 1
    end
    return 1
  end
  return usable[math.random(1, #usable)]
end

