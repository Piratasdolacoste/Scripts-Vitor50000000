local function changeStatStage(p, stat, delta, log)
  if delta < 0 then
    if hasAbility(p, "Clear Body") and not p._selfStatDrop then table.insert(log, p.name .. " teve sua habilidade Clear Body protegendo seus atributos!"); return false end
    if hasAbility(p, "Hyper Cutter") and stat == "atk" and not p._selfStatDrop then table.insert(log, p.name .. " foi protegido por Hyper Cutter!"); return false end
    if hasAbility(p, "Keen Eye") and stat == "acc" and not p._selfStatDrop then table.insert(log, p.name .. " foi protegido por Keen Eye!"); return false end
  end
  local st = ensureBattleStages(p)
  local old = st[stat] or 0
  local new = math.max(-6, math.min(6, old + delta))
  if new == old then
    if delta > 0 then
      table.insert(log, p.name .. " não pode aumentar mais " .. stat .. "!")
    elseif delta < 0 then
      table.insert(log, p.name .. " não pode diminuir mais " .. stat .. "!")
    end
    return false
  end
  st[stat] = new
  local labels = {atk="Ataque",def="Defesa",spa="Ataque Especial",spd="Defesa Especial",spe="Velocidade",acc="Precisão",eva="Evasão"}
  local label = labels[stat] or stat
  local amount = math.abs(new - old)
  local word = delta > 0 and "aumentou" or "diminuiu"
  table.insert(log, p.name .. " " .. word .. " " .. label .. " em " .. amount .. " estágio" .. (amount == 1 and "" or "s") .. "!")
  return true
end

local function applyStageEffectsFromDescription(user, target, move, log)
  local d = move.desc or ""
  local amount = d:find("three stages") and 3 or (d:find("two stages") and 2 or 1)
  local raises = d:find("Raises")
  local lowers = d:find("Lowers")
  if not raises and not lowers then return end
  local delta = raises and amount or -amount
  local recipient = d:find("user", 1, true) and user or target
  if delta < 0 and recipient == target and (target.mistTurns or 0) > 0 then
    table.insert(log, target.name .. " está protegido pelo Mist contra redução de atributos!")
    return
  end

  local function has(name) return d:find(name, 1, true) ~= nil end
  if has("Attack") and (not has("Special Attack") or has("Attack and Special Attack")) then changeStatStage(recipient, "atk", delta, log) end
  if has("Defense") and (not has("Special Defense") or has("Attack and Defense")) then changeStatStage(recipient, "def", delta, log) end
  if has("Special Attack") then changeStatStage(recipient, "spa", delta, log) end
  if has("Special Defense") then changeStatStage(recipient, "spd", delta, log) end
  if has("Speed") then changeStatStage(recipient, "spe", delta, log) end
  if has("accuracy") then changeStatStage(recipient, "acc", delta, log) end
  if has("evasion") then changeStatStage(recipient, "eva", delta, log) end
end

