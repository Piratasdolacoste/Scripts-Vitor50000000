-- fórmula oficial (Gen 3): XP ganho = floor(trainerMult * baseExp * nivelDoDerrotado / 7)
-- trainerMult = 1 em batalha selvagem, 1.5 contra treinador/outro jogador
local function calculateXpGain(defeatedPokedexId, defeatedLevel, isTrainerBattle)
  local info = GROWTH_AND_EXP[defeatedPokedexId]
  local baseExp = info and info.baseExp or 64
  local gain = math.floor(baseExp * defeatedLevel / 7)
  if isTrainerBattle then gain = math.floor(gain * 1.5) end
  return gain
end

-- devolve o nível correspondente a uma quantidade de XP total, pra uma curva
local function levelForXp(growthName, xp)
  local table_ = GROWTH_TABLE[growthName]
  for lvl = 100, 1, -1 do
    if xp >= table_[lvl] then return lvl end
  end
  return 1
end

local function xpForLevel(growthName, level)
  return GROWTH_TABLE[growthName][level]
end

