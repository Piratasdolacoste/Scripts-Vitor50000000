-- ===================================================================

-- monta os golpes iniciais: os últimos 4 que ele já teria aprendido até
-- esse nível (se aprendeu menos de 4 no total, usa todos que tiver)
local function startingMoves(pokedexId, level)
  local def = POKEMON[pokedexId]
  local learnable = {}
  for _, entry in ipairs(def.level) do
    if entry[1] <= level then table.insert(learnable, entry[2]) end
  end
  local moves, seen = {}, {}
  -- Mantém até os quatro golpes mais recentes, sem duplicar golpes repetidos no learnset.
  for i = #learnable, 1, -1 do
    local key = learnable[i]
    if MOVES[key] and not seen[key] then
      table.insert(moves, 1, MOVES[key]); seen[key] = true
      if #moves >= 4 then break end
    end
  end
  if #moves == 0 then moves = { MOVES.Tackle } end
  return moves
end

-- PP é por INSTÂNCIA do Pokémon, não pode ficar guardado no golpe
-- compartilhado (senão dois Pokémon com o mesmo golpe dividiriam o PP)
local function freshPP(moves)
  local pp = {}
  for i, m in ipairs(moves) do pp[i] = m.pp end
  return pp
end

-- cria um Pokémon novo (selvagem ou recém-capturado): sorteia IV/natureza,
-- EV zerado, XP no mínimo do nível dado
local function chooseAbility(pokedexId)
  local a = FR_ABILITIES[pokedexId] or {}
  if #a == 0 then return nil end
  if #a == 1 then return a[1] end
  return (math.random(1, 2) == 1) and a[1] or a[2]
end

local function chooseHeldItem(pokedexId)
  local h = FR_HELD_ITEMS[pokedexId]
  if not h then return nil end
  -- FireRed wild-item behavior: common item is 50%, rare item is 5%.
  if h[2] and h[2] ~= "None" and math.random(1,100) <= 5 then return h[2] end
  if h[1] and h[1] ~= "None" and math.random(1,100) <= 50 then return h[1] end
  return nil
end

