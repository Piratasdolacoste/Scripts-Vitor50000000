-- fórmula de captura simplificada (Gen 3), baseada na oficial:
--   a = (3*maxHP - 2*hp) * taxaDeCaptura * bônusDaBola * bônusDeStatus / (3*maxHP)
-- a>=255 = captura garantida. Abaixo disso, uso a probabilidade direta
-- a/255 em vez das 4 "shakes" de RNG do jogo de verdade — é uma
-- aproximação, não é 100% igual ao jogo original nesse detalhe específico.
local STATUS_CATCH_BONUS = {
  Sleep=2.0,
  Freeze=2.0,
  Paralysis=1.5,
  Poison=1.5,
  Burn=1.5,
}

-- FireRed usa multiplicadores internos em décimos:
-- Poké Ball = 10, Great = 15, Ultra = 20.
-- As bolas especiais abaixo seguem os casos de FireRed.
local BALL_IMAGE_CODE = {
  PokeBall="1534bff7873", GreatBall=nil, UltraBall=nil, MasterBall="157bfac671b",
  PremierBall=nil, RepeatBall=nil, TimerBall=nil, NestBall=nil,
  NetBall=nil, DiveBall=nil, LuxuryBall=nil
}

local caughtDex = {}

function isAlreadyCaught(playerName, dexId)
  return caughtDex[playerName] and caughtDex[playerName][dexId] == true
end

function markCaught(playerName, dexId)
  caughtDex[playerName] = caughtDex[playerName] or {}
  caughtDex[playerName][dexId] = true
end

function getBallMultiplier(playerName, ball, wildPokemon, battleTurn)
  local kind = ball.catchKind or "normal"

  if kind == "master" then
    return 255
  elseif kind == "repeat" then
    return isAlreadyCaught(playerName, wildPokemon.pokedexId) and 30 or 10
  elseif kind == "timer" then
    return math.min((battleTurn or 0) + 10, 40)
  elseif kind == "nest" then
    if wildPokemon.level < 40 then
      return math.max(10, 40 - wildPokemon.level)
    end
    return 10
  elseif kind == "net" then
    for _, t in ipairs(wildPokemon.types or {}) do
      if t == "Bug" or t == "Water" then return 30 end
    end
    return 10
  elseif kind == "dive" then
    -- O módulo atual não possui mapas subaquáticos; em encontros normais
    -- fica 1x, como FireRed fora de uma área subaquática.
    return 10
  end

  if kind == "great" then return 15 end
  if kind == "ultra" then return 20 end
  return 10
end

-- Captura baseada diretamente na rotina de BattleScript_CapturePokemon
-- do Pokémon FireRed:
--   odds = (catchRate * ballMultiplier / 10)
--           * (3*maxHP - 2*HP) / (3*maxHP)
--   Sleep/Freeze = x2
--   Poison/Burn/Paralysis/Toxic = x1.5
-- Se odds > 254, captura garantida.
-- Caso contrário, FireRed transforma odds na chance de cada uma das
-- quatro verificações de shake.
function tryCatch(playerName, wildPokemon, ball, battleTurn)
  if ball.catchKind == "master" then
    return true, 4
  end

  local catchRate = CAPTURE_RATE[wildPokemon.pokedexId] or 45
  local ballMultiplier = getBallMultiplier(playerName, ball, wildPokemon, battleTurn)

  -- O código C do FireRed faz divisão inteira em cada etapa.
  local odds = math.floor((catchRate * ballMultiplier) / 10)
  odds = math.floor(
    odds * (wildPokemon.maxHp * 3 - wildPokemon.hp * 2)
    / (3 * wildPokemon.maxHp)
  )

  local statusBonus = STATUS_CATCH_BONUS[wildPokemon.status]
  if statusBonus == 2.0 then
    odds = odds * 2
  elseif statusBonus == 1.5 then
    odds = math.floor(odds * 15 / 10)
  end

  if odds > 254 then
    return true, 4
  end

  -- Equivalente à sequência:
  -- odds = Sqrt(Sqrt(16711680 / odds));
  -- odds = 1048560 / odds;
  -- do código de FireRed.
  odds = math.max(1, odds)
  local shakeThreshold = math.floor(
    1048560 / math.sqrt(math.sqrt(16711680 / odds))
  )

  local shakes = 0
  for i = 1, 4 do
    if math.random(0, 65535) < shakeThreshold then
      shakes = shakes + 1
    else
      break
    end
  end

  return shakes == 4, shakes
end


