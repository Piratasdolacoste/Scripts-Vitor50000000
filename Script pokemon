  closeEvolutionPrompt(playerName)
  pendingEvolution[playerName] = nil

  if not accept or not newDef then
    notify(oldName .. " não evoluiu.", playerName)
    return
  end

  pokemon.pokedexId = pend.newId
  pokemon.speciesName = newDef.name
  if not pokemon.nickname then pokemon.name = newDef.name end
  pokemon.types = newDef.types
  pokemon.baseStats = newDef.stats
  pokemon.spriteCode = SPRITE_BY_ID[pend.newId]
  recalculateStats(pokemon)

  evolutionResult[playerName] = {
    oldName = oldName,
    newName = pokemon.name,
    newId = pend.newId,
    pokemon = pokemon
  }
  renderEvolutionResult(playerName)

  local b = battles[playerName]
  if b then
    -- Guarda a fase real para não reabrir uma batalha já encerrada após a evolução.
    b.phaseBeforeEvolution = b.phase
    if b.enemy and b.enemy.hp <= 0 then b.phaseBeforeEvolution = "finished" end
    b.phase = "evolution_result"
  end
end

local function checkEvolution(playerName, pokemon, log)
  local evo = EVOLUTIONS[pokemon.pokedexId]
  if not evo or evo.trigger == nil then return end
  if evo[1] then return end
  if evo.trigger ~= "level-up" or not evo.level then return end
  if pokemon.level < evo.level then return end

  local newId = NAME_TO_ID[evo.name]
  if not newId then return end
  if pendingEvolution[playerName] then return end

  pendingEvolution[playerName] = { pokemon = pokemon, newId = newId }
  if log then
    table.insert(log, pokemon.name .. " pode evoluir para " .. evo.name .. "!")
  end

  -- Se ainda existe uma escolha de golpe aberta, espera ela terminar.
  if not learnPrompts[playerName] then
    renderEvolutionPrompt(playerName)
  end
end

