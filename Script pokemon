local function translateMoveDesc(desc)
  return MOVE_DESC_PT[desc] or desc
end

local function moveDamageText(attacker, defender, move, weather)
  local desc = move.desc or ""

  -- Golpes de dano fixo sem efeito adicional.
  local fixed = string.match(desc, "Inflicts (%d+) points of damage%.")
  if fixed then return "Dano: " .. fixed end

  if desc == "Inflicts regular damage with no additional effect." then
    if move.power then
      local minDamage, maxDamage = moveDamageRange(attacker, defender, move, weather)
      if minDamage == 0 and maxDamage == 0 then return "Dano: 0 (imune)" end
      if minDamage == maxDamage then return "Dano: " .. tostring(minDamage) end
      return "Dano: " .. tostring(minDamage) .. "–" .. tostring(maxDamage)
    end
    return "Dano: —"
  end

  if not move.power then
    if desc == "Inflicts damage equal to the user’s level." then
      return "Dano: igual ao nível"
    elseif desc == "Inflicts twice the damage the user received from the last physical hit it took." then
      return "Dano: 2× dano físico recebido"
    elseif desc == "Inflicts twice the damage the user received from the last special hit it took." then
      return "Dano: 2× dano especial recebido"
    elseif desc == "Inflicts damage equal to half the target’s HP." then
      return "Dano: 1/2 do HP do alvo"
    end
    return "Dano: —"
  end

  local minDamage, maxDamage = moveDamageRange(attacker, defender, move, weather)
  if minDamage == 0 and maxDamage == 0 then return "Dano: 0 (imune)" end
  if minDamage == maxDamage then return "Dano: " .. tostring(minDamage) end
  return "Dano: " .. tostring(minDamage) .. "–" .. tostring(maxDamage)
end

local function moveExtraText(move)
  local desc = move.desc or ""
  if desc == "Inflicts regular damage with no additional effect." then
    return nil
  end
  return translateMoveDesc(desc)
end

local function moveAccuracyText(move)
  if move.accuracy then return "Precisão: " .. tostring(move.accuracy) .. "%" end
  return "Precisão: —"
end

function drawMovesButtons(playerName, b)
  -- Remove o menu principal para que nenhum botão antigo fique por cima.
  for _, id in ipairs({9010,9011,9012,9013,9014}) do
    ui.removeTextArea(id, playerName)
  end

  local m = b.player.moves
  local pp = b.player.pp or {}

  for i = 1, 4 do
    local move = m[i]
    local id = 9030 + i
    if move then
      local curPP = pp[i] or move.pp
      local colors = MOVE_COLOR[move.type] or { bg = 0x707070, border = 0x404040 }
      if curPP <= 0 then colors = { bg = 0x555555, border = 0x2E2E2E } end

      local damage = moveDamageText(b.player, b.enemy, move, b.weather)
      local extra = moveExtraText(move)
      local info = "PP: " .. curPP .. "/" .. move.pp .. "  |  " .. damage
      if move.accuracy then info = info .. "  |  " .. moveAccuracyText(move) end

      local label
      if extra then
        if #extra > 70 then extra = string.sub(extra, 1, 67) .. "..." end
        label = "<p align='center'><font size='10' color='#FFFFFF'><b>" .. move.name ..
          "</b>  [" .. move.type .. "]<br>" .. info .. "<br>" ..
          "<font size='8'>" .. extra .. "</font></font></p>"
      else
        label = "<p align='center'><font size='10' color='#FFFFFF'><b>" .. move.name ..
          "</b>  [" .. move.type .. "]<br>" .. info .. "</font></p>"
      end

      -- IMPORTANTE: o golpe inteiro é um link clicável.
      -- Antes só havia texto sem href, por isso os ataques não respondiam.
