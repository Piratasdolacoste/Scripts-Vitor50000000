local function applyMoveSpecialEffects(b, attacker, defender, move, totalDamage, hit, log)
  if not hit then return end
  local explicitStage = EXPLICIT_STAGE_MOVES[move.name]
  if explicitStage then
    for _, effect in ipairs(explicitStage.user or {}) do changeStatStage(attacker, effect[1], effect[2], log) end
    for _, effect in ipairs(explicitStage.target or {}) do
      if (defender.mistTurns or 0) <= 0 then changeStatStage(defender, effect[1], effect[2], log)
      else table.insert(log, defender.name .. " está protegido por Mist contra redução de atributos!") end
    end
  end
  if move.name == "Mean Look" or move.name == "Block" or move.name == "Spider Web" then
    defender.trappedTurns = 99; defender.trappedBy = attacker; defender.permanentTrap = true
    table.insert(log, defender.name .. " não pode fugir nem trocar enquanto estiver preso!")
  end
  applyContactAbility(attacker, defender, move, log)
  if move.name == "Mimic" then
    if defender.lastMoveName and MOVES[moveKeyByDisplayName(defender.lastMoveName)] then
      local copied=MOVES[moveKeyByDisplayName(defender.lastMoveName)]
      attacker.moves[1]=copied
      attacker.pp[1]=copied.pp
      table.insert(log, attacker.name .. " copiou " .. copied.name .. " com Mimic!")
    else table.insert(log, "Mimic falhou!") end
    return
  elseif move.name == "Sketch" then
    if defender.lastMoveName and MOVES[moveKeyByDisplayName(defender.lastMoveName)] then
      local copied=MOVES[moveKeyByDisplayName(defender.lastMoveName)]
      local slot=1
      for i,m in ipairs(attacker.moves) do if m.name == "Sketch" then slot=i; break end end
      attacker.moves[slot]=copied; attacker.pp[slot]=copied.pp
      table.insert(log, attacker.name .. " copiou " .. copied.name .. " com Sketch!")
    end
    return
  elseif move.name == "Psych Up" then
    attacker.statStages={atk=0,def=0,spa=0,spd=0,spe=0,acc=0,eva=0,crit=0}
    for k,v in pairs(ensureBattleStages(defender)) do attacker.statStages[k]=v end
    table.insert(log, attacker.name .. " copiou as mudanças de atributos de " .. defender.name .. "!")
    return
  elseif move.name == "Role Play" or move.name == "Skill Swap" then
    if move.name == "Role Play" then attacker.ability=defender.ability; table.insert(log, attacker.name .. " copiou a habilidade " .. tostring(attacker.ability) .. "!")
    else attacker.ability,defender.ability=defender.ability,attacker.ability; table.insert(log, "As habilidades foram trocadas!") end
    return
  elseif move.name == "Trick" then
    attacker.heldItem,defender.heldItem=defender.heldItem,attacker.heldItem
    table.insert(log, attacker.name .. " e " .. defender.name .. " trocaram seus itens!")
    return
  elseif move.name == "Thief" or move.name == "Covet" then
    if not attacker.heldItem and defender.heldItem and not hasAbility(defender,"Sticky Hold") then
      attacker.heldItem=defender.heldItem; defender.heldItem=nil
      table.insert(log, attacker.name .. " roubou o item segurado de " .. defender.name .. "!")
    end
  elseif move.name == "Knock Off" then
    if defender.heldItem and not hasAbility(defender,"Sticky Hold") then
      table.insert(log, defender.name .. " perdeu " .. defender.heldItem .. "!")
      defender.heldItem=nil
    end
  elseif move.name == "Rapid Spin" then
    attacker.trappedTurns=0; attacker.trappedBy=nil; attacker.seeded=false
    local hazards = ensureSpikes(b)
    hazards[attackerKey] = 0
    table.insert(log, attacker.name .. " removeu aprisionamento, Leech Seed e Spikes do seu lado!")
  elseif move.name == "Recycle" then
    if attacker.consumedItem then attacker.heldItem=attacker.consumedItem; attacker.consumedItem=nil; table.insert(log, attacker.name .. " recuperou seu item!") end
  elseif move.name == "Conversion" then
    local candidates={}
    for _,m in ipairs(attacker.moves or {}) do if m.type then table.insert(candidates,m.type) end end
    if #candidates>0 then attacker.types={candidates[math.random(1,#candidates)]}; table.insert(log, attacker.name .. " mudou para o tipo " .. attacker.types[1] .. "!") end
  elseif move.name == "Conversion 2" then
    local last=defender.lastMoveName; local lm=last and MOVES[moveKeyByDisplayName(last)]
    if lm then
      local resist={Normal={Ghost=1},Fire={Fire=1,Water=1,Rock=1},Water={Water=1,Grass=1,Dragon=1},Electric={Electric=1,Grass=1,Dragon=1},Grass={Fire=1,Grass=1,Poison=1,Flying=1,Bug=1,Dragon=1},Ice={Fire=1,Water=1,Ice=1,Steel=1},Fighting={Poison=1,Flying=1,Psychic=1,Bug=1},Poison={Poison=1,Ground=1,Rock=1,Ghost=1},Ground={Grass=1,Bug=1,Flying=1},Flying={Electric=1,Rock=1,Steel=1},Psychic={Psychic=1,Steel=1},Bug={Fire=1,Fighting=1,Poison=1,Flying=1,Ghost=1,Steel=1},Rock={Fighting=1,Ground=1,Steel=1},Ghost={Dark=1,Steel=1},Dragon={Steel=1},Dark={Fighting=1,Dark=1,Steel=1},Steel={Fire=1,Water=1,Electric=1,Steel=1}}
      local list={}; for t,_ in pairs(resist[lm.type] or {}) do table.insert(list,t) end
      if #list>0 then attacker.types={list[math.random(1,#list)]}; table.insert(log,attacker.name .. " mudou de tipo com Conversion 2!") end
    end
  elseif move.name == "Camouflage" then
    attacker.types={"Normal"}; table.insert(log,attacker.name .. " mudou para o tipo Normal!")
  elseif move.name == "Uproar" then
    attacker.rampageTurns=math.max(attacker.rampageTurns or 0,2); attacker.rampageMove=move; attacker.uproar=true
    table.insert(log,"O tumulto impede Pokémon de dormir!")
  elseif move.name == "Sleep Talk" then
    if attacker.status == "Sleep" then
      local choices={}; for i,m in ipairs(attacker.moves or {}) do if m.name ~= "Sleep Talk" and (attacker.pp[i] or 0)>0 then table.insert(choices,i) end end
      if #choices>0 then attacker.sleepTalkSlot=choices[math.random(1,#choices)]; table.insert(log,attacker.name.." usou Sleep Talk!") end
    end
  elseif move.name == "Snatch" then
    attacker.snatch=true; table.insert(log,attacker.name.." está pronto para roubar um efeito benéfico!")
  elseif move.name == "Baton Pass" then
    attacker.batonPass=true; table.insert(log,attacker.name.." preparou Baton Pass para trocar e passar seus efeitos!")
  end
  -- Condições e efeitos específicos da Gen III.
  if move.name == "Brick Break" then
    if (defender.reflectTurns or 0) > 0 then defender.reflectTurns = 0; table.insert(log, "Brick Break destruiu o Reflect!") end
    if (defender.lightScreenTurns or 0) > 0 then defender.lightScreenTurns = 0; table.insert(log, "Brick Break destruiu o Light Screen!") end
  elseif move.name == "Smelling Salt" and defender.status == "Paralysis" then
    defender.status = nil
    table.insert(log, defender.name .. " foi curado da paralisia por Smelling Salt!")
  elseif move.name == "Wake-Up Slap" and defender.status == "Sleep" then
    defender.status = nil; defender.sleepTurns = 0
    table.insert(log, defender.name .. " acordou com Wake-Up Slap!")
  elseif move.name == "Facade" and attacker.status then
    -- O dobro de poder já é aplicado no cálculo de dano.
  elseif move.name == "Foresight" or move.name == "Odor Sleuth" then
    defender.foresight = true
    ensureBattleStages(defender).eva = 0
    table.insert(log, defender.name .. " teve sua Evasão anulada e pode ser atingido por Normal/Fighting mesmo sendo Ghost!")
  elseif move.name == "Perish Song" then
    attacker.perishCount = 3; defender.perishCount = 3
    table.insert(log, "Perish Song marcou os dois Pokémon para desmaiar em três turnos!")
  elseif move.name == "Ingrain" then
    attacker.ingrain = true
    table.insert(log, attacker.name .. " criou raízes no campo!")
  elseif move.name == "Yawn" then
    defender.yawnTurns = 1
    table.insert(log, defender.name .. " ficou sonolento!")
  elseif move.name == "Safeguard" then
    attacker.safeguardTurns = 5
    table.insert(log, attacker.name .. " está protegido contra status por 5 turnos!")
  elseif move.name == "Mist" then
    attacker.mistTurns = 5
    table.insert(log, attacker.name .. " está protegido contra redução de atributos por 5 turnos!")
  elseif move.name == "Rage" then
    attacker.rage = true
  elseif move.name == "Rollout" then
    attacker.rolloutTurns = (attacker.rolloutTurns or 0) + 1
    attacker.rolloutPower = math.min(480, 30 * (2 ^ attacker.rolloutTurns))
  elseif move.name == "Fury Cutter" then
    attacker.furyCutterCount = math.min(4, (attacker.furyCutterCount or 0) + 1)
  else
    if move.name ~= "Rollout" then attacker.rolloutTurns = 0; attacker.rolloutPower = 30 end
    if move.name ~= "Fury Cutter" then attacker.furyCutterCount = 0 end
  end

  -- Efeitos adicionais dos TM/HM que não são apenas dano.
  if move.name == "Rock Smash" and math.random(1,100) <= 50 then
    changeStatStage(defender, "def", -1, log)
  elseif move.name == "Steel Wing" and math.random(1,100) <= 10 then
    changeStatStage(attacker, "def", 1, log)
  elseif move.name == "Rock Tomb" or move.name == "Icy Wind" then
    changeStatStage(defender, "spe", -1, log)
  elseif move.name == "Mud-Slap" then
    changeStatStage(defender, "acc", -1, log)
  elseif move.name == "Iron Tail" and math.random(1,100) <= 30 then
    changeStatStage(defender, "def", -1, log)
  elseif move.name == "Crunch" and math.random(1,100) <= 20 then
    changeStatStage(defender, "spd", -1, log)
  elseif move.name == "Psychic" and math.random(1,100) <= 10 then
    changeStatStage(defender, "spd", -1, log)
  elseif move.name == "Shadow Ball" and math.random(1,100) <= 20 then
    changeStatStage(defender, "spd", -1, log)
  elseif move.name == "Aurora Beam" and math.random(1,100) <= 10 then
    changeStatStage(defender, "atk", -1, log)
  elseif move.name == "BubbleBeam" and math.random(1,100) <= 10 then
    changeStatStage(defender, "spe", -1, log)
  elseif move.name == "Water Pulse" and math.random(1,100) <= 20 and not defender.confusedTurns then
    defender.confusedTurns = math.random(1,4)
    table.insert(log, defender.name .. " ficou confuso com Water Pulse!")
  elseif move.name == "Attract" then
    if attacker.gender and defender.gender and attacker.gender ~= defender.gender and attacker.gender ~= "genderless" and defender.gender ~= "genderless" then
      defender.infatuated = true
      defender.infatuatedBy = attacker.name
      table.insert(log, defender.name .. " ficou apaixonado por " .. attacker.name .. "!")
    else
      table.insert(log, "Attract falhou: os gêneros não permitem atração neste caso.")
    end
  elseif move.name == "Hail" then
    b.weather = {kind="hail", turnsLeft=WEATHER_DURATION}
    table.insert(log, "Começou a cair granizo!")
  elseif move.name == "Focus Punch" then
    -- A falha por sofrer dano antes de agir é tratada no início do turno.
  end

  -- Golpes utilitários/condicionais da Gen III.
  if move.name == "Substitute" then
    if attacker.substituteHp and attacker.substituteHp > 0 then
      table.insert(log, attacker.name .. " já possui um Substitute!")
    elseif attacker.hp <= math.floor(attacker.maxHp / 4) then
      table.insert(log, attacker.name .. " não tem HP suficiente para Substitute!")
    else
      local cost = math.floor(attacker.maxHp / 4)
      attacker.hp = attacker.hp - cost
      attacker.substituteHp = cost
      table.insert(log, attacker.name .. " criou um Substitute com " .. cost .. " HP!")
    end
  elseif move.name == "Endure" or move.name == "Detect" then
    attacker.endureThisTurn = true
    table.insert(log, attacker.name .. " vai resistir com pelo menos 1 HP!")
  elseif move.name == "Destiny Bond" then
    attacker.destinyBond = true
    table.insert(log, attacker.name .. " preparou Destiny Bond!")
  elseif move.name == "Refresh" then
    if attacker.status == "Burn" or attacker.status == "Paralysis" or attacker.status == "Poison" or attacker.status == "Toxic" then
      attacker.status = nil; attacker.toxicCounter = 0
      table.insert(log, attacker.name .. " foi curado por Refresh!")
    end
  elseif move.name == "Aromatherapy" or move.name == "Heal Bell" then
    attacker.status = nil; attacker.toxicCounter = 0
    table.insert(log, attacker.name .. " foi curado de status!")
  elseif move.name == "Memento" then
    changeStatStage(defender, "atk", -2, log)
    changeStatStage(defender, "spa", -2, log)
    attacker.hp = 0
    table.insert(log, attacker.name .. " se sacrificou com Memento!")
  elseif move.name == "Roar" or move.name == "Whirlwind" then
    if b.isWildBattle or b.isTrainer == false then
      b.forceEndBattle = true
      table.insert(log, defender.name .. " foi expulso da batalha!")
    else
      b.forceSwitchTarget = defender
      table.insert(log, defender.name .. " deve trocar de Pokémon!")
    end
  elseif move.name == "Spikes" then
    local hazards = ensureSpikes(b)
    hazards[defenderKey] = math.min(3, (hazards[defenderKey] or 0) + 1)
    table.insert(log, "Spikes foram espalhadas no lado adversário (" .. hazards[defenderKey] .. "/3 camadas)!")
  elseif move.name == "Encore" then
    if defender.lastMoveName then
      defender.encoreMove = defender.lastMoveName
      defender.encoreTurns = math.random(2, 6)
      table.insert(log, defender.name .. " ficou preso usando " .. defender.lastMoveName .. "!")
    end
  elseif move.name == "Taunt" then
    defender.tauntTurns = 3
    table.insert(log, defender.name .. " foi provocado e não pode usar golpes de status por 3 turnos!")
  elseif move.name == "Torment" then
    defender.torment = true
    table.insert(log, defender.name .. " não poderá repetir o mesmo golpe consecutivamente!")
  elseif move.name == "Imprison" then
    attacker.imprisonedMoves = {}
    for _, m in ipairs(attacker.moves or {}) do attacker.imprisonedMoves[m.name] = true end
    table.insert(log, attacker.name .. " selou os golpes que compartilha com o alvo!")
  elseif move.name == "Synthesis" or move.name == "Moonlight" then
    local factor = 0.5
    if b.weather and b.weather.kind == "sun" then factor = 2/3
    elseif b.weather and (b.weather.kind == "rain" or b.weather.kind == "sandstorm" or b.weather.kind == "hail") then factor = 0.25 end
    local heal = math.max(1, math.floor(attacker.maxHp * factor)); local before = attacker.hp
    attacker.hp = math.min(attacker.maxHp, attacker.hp + heal)
    table.insert(log, attacker.name .. " recuperou " .. (attacker.hp-before) .. " HP!")
  elseif move.name == "Belly Drum" then
    if attacker.hp > math.floor(attacker.maxHp / 2) then
      attacker.hp = attacker.hp - math.floor(attacker.maxHp / 2)
      ensureBattleStages(attacker).atk = 6
      table.insert(log, attacker.name .. " maximizou seu Ataque com Belly Drum!")
    else
      table.insert(log, attacker.name .. " não tinha HP suficiente para Belly Drum!")
    end
  elseif move.name == "Stockpile" then
    attacker.stockpileCount = math.min(3, (attacker.stockpileCount or 0) + 1)
    changeStatStage(attacker, "def", 1, log); changeStatStage(attacker, "spd", 1, log)
    table.insert(log, attacker.name .. " armazenou energia (" .. attacker.stockpileCount .. "/3)!")
  elseif move.name == "Swallow" then
    local n = attacker.stockpileCount or 0
    if n > 0 then
      local factor = n == 1 and 0.25 or (n == 2 and 0.5 or 1)
      local heal = math.max(1, math.floor(attacker.maxHp * factor)); local before = attacker.hp
      attacker.hp = math.min(attacker.maxHp, attacker.hp + heal); attacker.stockpileCount = 0
      changeStatStage(attacker, "def", -n, log); changeStatStage(attacker, "spd", -n, log)
      table.insert(log, attacker.name .. " recuperou " .. (attacker.hp-before) .. " HP com Swallow!")
    end
  elseif move.name == "Spit Up" then
    local n = attacker.stockpileCount or 0
    if n > 0 then
      attacker.stockpileCount = 0
      changeStatStage(attacker, "def", -n, log); changeStatStage(attacker, "spd", -n, log)
      table.insert(log, attacker.name .. " liberou toda a energia armazenada!")
    end
  elseif move.name == "Spite" then
    local idx
    for i,m in ipairs(defender.moves or {}) do if m.name == defender.lastMoveName then idx=i; break end end
    if idx and defender.pp[idx] then
      local old = defender.pp[idx]; defender.pp[idx] = math.max(0, old - 4)
      table.insert(log, defender.name .. " perdeu " .. (old-defender.pp[idx]) .. " PP de " .. defender.lastMoveName .. "!")
    end
  elseif move.name == "Grudge" then
    attacker.grudge = true
    table.insert(log, attacker.name .. " marcou o próximo golpe que o derrotar com Grudge!")
  elseif move.name == "Charge" then
    changeStatStage(attacker, "spd", 1, log)
    attacker.chargeBoost = true
    table.insert(log, attacker.name .. " fortaleceu seus golpes elétricos!")
  elseif move.name == "Mud Sport" then
    attacker.mudSport = true; defender.mudSport = true
    table.insert(log, "Mud Sport enfraqueceu golpes elétricos!")
  elseif move.name == "Water Sport" then
    attacker.waterSport = true; defender.waterSport = true
    table.insert(log, "Water Sport enfraqueceu golpes de fogo!")
  elseif move.name == "Ancient Power" or move.name == "Silver Wind" then
    if math.random(1,100) <= 10 then
      for _, stat in ipairs({"atk","def","spa","spd","spe"}) do changeStatStage(attacker, stat, 1, log) end
      table.insert(log, attacker.name .. " aumentou todos os seus atributos!")
    end
  elseif move.name == "Meteor Mash" then
    if math.random(1,100) <= 20 then changeStatStage(attacker, "atk", 1, log) end
  elseif move.name == "Pain Split" then
    local avg = math.floor((attacker.hp + defender.hp) / 2)
    attacker.hp = math.max(1, math.min(attacker.maxHp, avg))
    defender.hp = math.max(1, math.min(defender.maxHp, avg))
    table.insert(log, "Pain Split igualou o HP dos dois Pokémon!")
  end

  if defender.hitSubstituteThisTurn then
    -- Substitute bloqueia status, flinch e redução de atributos causados pelo golpe.
    return
  end

  -- Efeitos de estágios são baseados nos dados/descrições dos golpes.
  if not EXPLICIT_STAGE_MOVES[move.name] and move.category == "status" then
    applyStageEffectsFromDescription(attacker, defender, move, log)
  end
  if move.name == "Overheat" and totalDamage > 0 then
    attacker._selfStatDrop=true; changeStatStage(attacker, "spa", -2, log); attacker._selfStatDrop=nil
  end

  -- Cura/dreno: drainPercent positivo cura o usuário.
  if move.drainPercent and move.drainPercent > 0 and totalDamage > 0 then
    local heal = math.max(1, math.floor(totalDamage * move.drainPercent / 100))
    if hasAbility(defender,"Liquid Ooze") then
      attacker.hp = math.max(0, attacker.hp - heal)
      table.insert(log, attacker.name .. " sofreu " .. heal .. " de dano por Liquid Ooze!")
      heal = 0
    end
    local before = attacker.hp
    attacker.hp = math.min(attacker.maxHp, attacker.hp + heal)
    table.insert(log, attacker.name .. " recuperou " .. (attacker.hp - before) .. " de HP!")
  end

  -- Aprisionamento por 2-5 turnos.
  if move.statusEffect == "Trap" then
    defender.trappedTurns = math.random(2, 5)
    defender.trappedBy = attacker
    table.insert(log, defender.name .. " ficou preso por " .. defender.trappedTurns .. " turnos!")
  end

  -- Confusão é um status volátil e pode coexistir com Burn/Poison/etc.
  local chance = move.statusChance
  if chance == 0 then chance = 100 end
  if hasAbility(defender, "Shield Dust") then chance = 0 end
  if hasAbility(attacker, "Serene Grace") and chance > 0 and chance < 100 then chance = math.min(100, chance * 2) end
  if move.statusEffect == "Confusion" and not defender.confusedTurns then defender.confusedTurns = 0 end
  if move.statusEffect == "Confusion" and defender.confusedTurns <= 0 and math.random(1,100) <= (chance or 100) then
    defender.confusedTurns = math.random(2, 5)
    table.insert(log, defender.name .. " ficou confuso!")
  end

  -- Status principais: 0 no banco de dados significa efeito garantido.
  if move.statusEffect and move.statusEffect ~= "Trap" and move.statusEffect ~= "Confusion"
      and move.statusEffect ~= "Leech Seed" and move.statusEffect ~= "Disable"
      and move.statusEffect ~= "Nightmare" and move.statusEffect ~= "Perish Song"
      and move.statusEffect ~= "Ingrain" and move.statusEffect ~= "Yawn" then
    local requested = move.statusEffect
    if move.name == "Poison Fang" then requested = "Toxic" end
    local immune = false
    if requested == "Poison" or requested == "Toxic" then
      immune = (defender.types[1] == "Poison" or defender.types[2] == "Poison" or defender.types[1] == "Steel" or defender.types[2] == "Steel" or hasAbility(defender, "Immunity"))
    elseif requested == "Burn" then
      immune = (defender.types[1] == "Fire" or defender.types[2] == "Fire" or hasAbility(defender, "Water Veil"))
    elseif requested == "Freeze" then
      immune = (defender.types[1] == "Ice" or defender.types[2] == "Ice" or hasAbility(defender, "Magma Armor"))
    end
    if requested == "Paralysis" and hasAbility(defender, "Limber") then immune = true end
    if move.name == "Thunder Wave" and (defender.types[1] == "Ground" or defender.types[2] == "Ground") then immune = true end
    if requested == "Sleep" and (hasAbility(defender, "Insomnia") or hasAbility(defender, "Vital Spirit")) then immune = true end
    if requested == "Confusion" and hasAbility(defender, "Own Tempo") then immune = true end
    if defender.safeguardTurns and defender.safeguardTurns > 0 then immune = true end
    if defender.substituteHp and defender.substituteHp > 0 then immune = true end
    if requested == "Burn" and defender.status == "Freeze" and (move.type == "Fire" or move.name == "Scald") then
      defender.status = nil
      table.insert(log, defender.name .. " descongelou!")
    end
    if not defender.status and not immune and math.random(1,100) <= (chance or 100) then
      defender.status = requested
      if requested == "Sleep" then defender.sleepTurns = math.random(1,4) end
      if requested == "Toxic" then defender.toxicCounter = 0 end
      if hasAbility(defender, "Early Bird") and requested == "Sleep" then defender.sleepTurns=math.max(1,math.floor(defender.sleepTurns/2)) end
      table.insert(log, defender.name .. " foi afetado por " .. requested .. "!")
      if hasAbility(defender, "Synchronize") and (requested == "Burn" or requested == "Paralysis" or requested == "Poison" or requested == "Toxic") and not attacker.status then attacker.status=requested; attacker.toxicCounter=0; table.insert(log, attacker.name .. " recebeu o mesmo status por Synchronize!") end
    end
  end

  if move.statusEffect == "Disable" and not defender.disabledMove and defender.lastMoveName then
    defender.disabledMove = defender.lastMoveName
    defender.disabledTurns = math.random(1, 8)
    table.insert(log, defender.name .. " teve " .. defender.lastMoveName .. " desabilitado!")
  end

  -- Flinch só impede o alvo se ele ainda não tiver agido naquele turno.
  if move.flinchChance and not defender.actedThisTurn and not hasAbility(defender, "Inner Focus") and math.random(1,100) <= (hasAbility(attacker, "Serene Grace") and math.min(100, move.flinchChance*2) or move.flinchChance) then
    defender.flinched = true
    table.insert(log, defender.name .. " recuou e ficou sem conseguir agir!")
  end
  if attacker.heldItem == "KingsRock" and not move.flinchChance and not defender.actedThisTurn and not hasAbility(defender,"Inner Focus") and math.random(1,100) <= 10 then
    defender.flinched=true; table.insert(log, defender.name .. " recuou por causa de King's Rock!")
  end

  if move.name == "Recover" or move.name == "Soft-Boiled" then
    local heal = math.max(1, math.floor(attacker.maxHp / 2))
    local before = attacker.hp
    attacker.hp = math.min(attacker.maxHp, attacker.hp + heal)
    table.insert(log, attacker.name .. " recuperou " .. (attacker.hp - before) .. " de HP!")
  elseif move.name == "Rest" then
    attacker.hp = attacker.maxHp
    attacker.status = "Sleep"
    attacker.sleepTurns = 2
    table.insert(log, attacker.name .. " dormiu e recuperou todo o HP!")
  elseif move.name == "Haze" then
    local a = ensureBattleStages(attacker)
    local d = ensureBattleStages(defender)
    for k in pairs(a) do a[k] = 0 end
    for k in pairs(d) do d[k] = 0 end
    table.insert(log, "Haze resetou os estágios de Ataque, Defesa, Velocidade, Precisão e Evasão!")
  elseif move.name == "Reflect" then
    attacker.reflectTurns = 5
    table.insert(log, "Reflect reduziu o dano físico por 5 turnos!")
  elseif move.name == "Light Screen" then
    attacker.lightScreenTurns = 5
    table.insert(log, "Light Screen reduziu o dano especial por 5 turnos!")
  elseif move.name == "Focus Energy" then
    attacker.focusEnergy = true
    table.insert(log, attacker.name .. " concentrou sua energia!")
  elseif move.name == "Tri Attack" then
    if not hasAbility(defender, "Shield Dust") and math.random(1,100) <= 20 and not defender.status
        and not (defender.safeguardTurns and defender.safeguardTurns > 0)
        and not (defender.substituteHp and defender.substituteHp > 0) then
      local r = math.random(1,3)
      local st = ({"Burn", "Freeze", "Paralysis"})[r]
      local immune = (st == "Burn" and (defender.types[1] == "Fire" or defender.types[2] == "Fire" or hasAbility(defender, "Water Veil")))
        or (st == "Freeze" and (defender.types[1] == "Ice" or defender.types[2] == "Ice" or hasAbility(defender, "Magma Armor")))
        or (st == "Paralysis" and hasAbility(defender, "Limber"))
      if not immune then defender.status = st; table.insert(log, defender.name .. " sofreu " .. st .. " com Tri Attack!") end
    end
  elseif move.name == "Nightmare" then
    if defender.status == "Sleep" then
      defender.nightmare = true
      table.insert(log, defender.name .. " está tendo pesadelos!")
    end
  elseif move.name == "Curse" then
    if attacker.types[1] == "Ghost" or attacker.types[2] == "Ghost" then
      local cost = math.max(1, math.floor(attacker.maxHp / 2))
      attacker.hp = math.max(0, attacker.hp - cost)
      defender.cursed = true
      table.insert(log, attacker.name .. " sacrificou HP e amaldiçoou " .. defender.name .. "!")
    else
      changeStatStage(attacker, "spe", -1, log)
      changeStatStage(attacker, "atk", 1, log)
      changeStatStage(attacker, "def", 1, log)
    end
  elseif move.name == "Self-Destruct" or move.name == "Explosion" then
    attacker.hp = 0
    table.insert(log, attacker.name .. " explodiu e desmaiou!")
  end
end

resolveMove = function(b, attackerKey, defenderKey, moveSlotIndex, log)
  local attacker, defender = b[attackerKey], b[defenderKey]
  if attacker then attacker.participated = true end
  if defender then defender.participated = true end
  if attacker.hp <= 0 then return end
  ensureBattleStages(attacker); ensureBattleStages(defender)
  local move = attacker.moves[moveSlotIndex]
  if attacker.encoreTurns and attacker.encoreTurns > 0 and attacker.encoreMove then
    for i, m in ipairs(attacker.moves or {}) do
      if m.name == attacker.encoreMove and (attacker.pp[i] or 0) > 0 then moveSlotIndex = i; move = m; break end
    end
    attacker.encoreTurns = attacker.encoreTurns - 1
    if attacker.encoreTurns <= 0 then attacker.encoreMove = nil end
  end
  if not move then return end
  if attacker.choiceLockedMove and move.name ~= attacker.choiceLockedMove then
    table.insert(log, attacker.name .. " está preso no golpe " .. attacker.choiceLockedMove .. " por Choice Band!")
    return
  end
  if move.name == "Mirror Move" and defender.lastMoveName then
    local copied=MOVES[moveKeyByDisplayName(defender.lastMoveName)]
    if copied and copied.name ~= "Mirror Move" then move=copied; table.insert(log,attacker.name.." copiou "..move.name.." com Mirror Move!") else return end
  end
  if move.name == "Sleep Talk" and attacker.status == "Sleep" then
    local choices={}
    for i,m in ipairs(attacker.moves or {}) do if m.name ~= "Sleep Talk" and (attacker.pp[i] or 0)>0 then table.insert(choices,i) end end
    if #choices>0 then moveSlotIndex=choices[math.random(1,#choices)]; move=attacker.moves[moveSlotIndex] else return end
  end
  local allEmpty = true
  for _, pp in ipairs(attacker.pp or {}) do if pp and pp > 0 then allEmpty=false; break end end
  if allEmpty then
    move = MOVES.Struggle or {name="Struggle", type="Normal", category="physical", power=50, pp=1, accuracy=nil, priority=0}
    moveSlotIndex = nil
    table.insert(log, attacker.name .. " não tem PP! Usou Struggle!")
  end
  local executingCharge = false
  attacker.actedThisTurn = true
  if hasAbility(attacker, "Truant") then
    if attacker.truantLoaf then
      attacker.truantLoaf = false
      table.insert(log, attacker.name .. " está preguiçoso por causa de Truant e não agiu!")
      return
    else
      attacker.truantLoaf = true
    end
  end

  -- Abilities que impedem/alteram estados.
  if hasAbility(attacker, "Insomnia") or hasAbility(attacker, "Vital Spirit") then
    if attacker.status == "Sleep" then attacker.status=nil; attacker.sleepTurns=0; table.insert(log, attacker.name .. " não pode dormir por causa de sua habilidade!") end
  end
  if hasAbility(attacker, "Early Bird") and attacker.status == "Sleep" and attacker.sleepTurns and attacker.sleepTurns > 1 then
    attacker.sleepTurns = math.max(1, math.floor(attacker.sleepTurns / 2))
  end
  if (hasAbility(attacker, "Limber") and move.statusEffect == "Paralysis") or (hasAbility(attacker, "Immunity") and (move.statusEffect == "Poison" or move.statusEffect == "Toxic")) then
    -- immunity is handled again by the status block; this prevents accidental application.
  end

  -- Efeitos voláteis que impedem a ação.
  if attacker.flinched then
    attacker.flinched = false
    table.insert(log, attacker.name .. " recuou e não conseguiu agir!")
    return
  end
  if (attacker.confusedTurns or 0) > 0 then
    attacker.confusedTurns = attacker.confusedTurns - 1
    if math.random() < 0.5 then
      local selfDamage = math.max(1, math.floor(((2 * attacker.level / 5 + 2) * 40 * attacker.stats.atk / math.max(1, attacker.stats.def)) / 50) + 2)
      attacker.hp = math.max(0, attacker.hp - selfDamage)
      table.insert(log, attacker.name .. " se machucou na própria confusão! Dano: " .. selfDamage)
      return
    elseif attacker.confusedTurns <= 0 then
      table.insert(log, attacker.name .. " voltou ao normal!")
    end
  end
  if attacker.infatuated and math.random(1,100) <= 50 then
    table.insert(log, attacker.name .. " está apaixonado e não conseguiu atacar!")
    return
  end
  if attacker.disabledTurns and attacker.disabledTurns > 0 then
    attacker.disabledTurns = attacker.disabledTurns - 1
    if attacker.disabledMove and move.name == attacker.disabledMove then
      table.insert(log, attacker.name .. " não pode usar " .. move.name .. " porque está desabilitado!")
      return
    end
    if attacker.disabledTurns <= 0 then attacker.disabledMove = nil end
  end
  if (attacker.trappedTurns or 0) > 0 and attacker.trappedBy then
    -- Um Pokémon preso ainda pode atacar; apenas não pode ser retirado/escapar.
  end
  if move.name == "Focus Punch" and attacker.tookDamageThisTurn then
    table.insert(log, attacker.name .. " perdeu o foco e Focus Punch falhou!")
    return
  end
  if attacker.tauntTurns and attacker.tauntTurns > 0 and move.category == "status" then
    table.insert(log, attacker.name .. " está sob Taunt e não pode usar golpes de status!")
    return
  end
  if defender.imprisonedMoves and defender.imprisonedMoves[move.name] then
    table.insert(log, attacker.name .. " não pode usar " .. move.name .. " por causa de Imprison!")
    return
  end
  if attacker.torment and attacker.lastMoveName == move.name then
    table.insert(log, attacker.name .. " está sob Torment e não pode repetir " .. move.name .. "!")
    return
  end

  if attacker.rechargeTurns and attacker.rechargeTurns > 0 then
    attacker.rechargeTurns = attacker.rechargeTurns - 1
    table.insert(log, attacker.name .. " está recarregando e não pode agir!")
    return
  end
  if attacker.rampageTurns and attacker.rampageTurns > 0 and attacker.rampageMove then
    move = attacker.rampageMove
    attacker.rampageTurns = attacker.rampageTurns - 1
  end

  -- Bide força o Pokémon a continuar acumulando e libera o dano depois.
  if attacker.bideTurns and attacker.bideTurns > 0 then
    attacker.bideTurns = attacker.bideTurns - 1
    if attacker.bideTurns <= 0 then
      local dmg = math.max(1, attacker.bideDamage * 2)
      defender.hp = math.max(0, defender.hp - dmg)
      table.insert(log, attacker.name .. " liberou Bide! Dano: " .. dmg)
      attacker.bideDamage = 0
    else
      table.insert(log, attacker.name .. " está acumulando energia com Bide!")
    end
    return
  end

  -- Golpes de dois turnos: o primeiro turno prepara, o segundo executa.
  if attacker.charging and attacker.chargeMove then
    move = attacker.chargeMove
    executingCharge = true
    attacker.charging = false
    attacker.chargeMove = nil
    table.insert(log, attacker.name .. " completou " .. move.name .. "!")
  end

  if attacker.status then
    local s = STATUS[attacker.status]
    if s and s.onTryMove then
      local canMove, msg = s.onTryMove(attacker)
      table.insert(log, attacker.name .. " " .. (msg or (attacker.status == "Paralysis" and "está paralisado, mas conseguiu se mover!" or "conseguiu se mover!")))
      if not canMove then return end
    end
  end

  if attacker.heldItem == "ChoiceBand" and not attacker.choiceLockedMove and move.name ~= "Struggle" then attacker.choiceLockedMove=move.name end

  -- PP é gasto ao TENTAR o golpe, mesmo se errar ou for bloqueado —
  -- só não gasta se nem conseguiu agir (sono/paralisia acima já retornou)
  if attacker.pp and attacker.pp[moveSlotIndex] and not executingCharge and not (attacker.bideTurns and attacker.bideTurns > 0) then
    attacker.pp[moveSlotIndex] = math.max(0, attacker.pp[moveSlotIndex] - 1)
    if hasAbility(defender, "Pressure") and move.name ~= "Struggle" then
      attacker.pp[moveSlotIndex] = math.max(0, attacker.pp[moveSlotIndex] - 1)
      table.insert(log, defender.name .. " aumentou o gasto de PP com Pressure!")
    end
  end

  if move.name == "Nature Power" then
    local natureMove = MOVES.TriAttack or MOVES.TriAttack
    if natureMove then move = natureMove; table.insert(log, attacker.name .. " usou Nature Power, que virou Tri Attack!") end
  end

  attacker.lastMoveName = move.name

  if move.name == "Spit Up" and (attacker.stockpileCount or 0) <= 0 then
    table.insert(log, attacker.name .. " não tem energia armazenada para usar Spit Up!")
    return
  end

  if move.name == "Metronome" then
    local candidates = {}
    for name, m in pairs(MOVES) do
      if name ~= "Metronome" and m.name ~= "Metronome" then table.insert(candidates, name) end
    end
    if #candidates > 0 then
      local chosenName = candidates[math.random(1, #candidates)]
      move = MOVES[chosenName]
      table.insert(log, attacker.name .. " escolheu " .. move.name .. " com Metronome!")
    end
  end

  if move.name == "Transform" then
    executeTransform(attacker, defender, log)
    return
  end

  if move.name == "Bide" then
    attacker.bideTurns = 2
    attacker.bideDamage = 0
    table.insert(log, attacker.name .. " começou a acumular energia!")
    return
  end

  if move.name == "Future Sight" then
    performFutureSight(b, attackerKey, defenderKey, move, log)
    return
  end

  if move.name == "Leech Seed" then
    if defender.types[1] == "Grass" or defender.types[2] == "Grass" or hasAbility(defender, "Suction Cups") then
      table.insert(log, defender.name .. " não pode ser afetado por Leech Seed!")
      return
    end
    if defender.seeded then
      table.insert(log, defender.name .. " já está com Leech Seed.")
    else
      defender.seeded = true
      table.insert(log, defender.name .. " foi plantado com Leech Seed!")
    end
    return
  end

  if (move.name == "Solar Beam" or move.name == "Dig" or move.name == "Fly" or move.name == "Bounce" or move.name == "Skull Bash" or move.name == "Sky Attack") and not attacker.charging and not (move.name == "Solar Beam" and b.weather and b.weather.kind == "sun") then
    attacker.charging = true
    attacker.chargeMove = move
    attacker.chargeTurns = 1
    if move.name == "Skull Bash" then changeStatStage(attacker, "def", 1, log) end
    table.insert(log, attacker.name .. " está se preparando para usar " .. move.name .. "!")
    return
  end

  if move.name == "Protect" then
    local chance = 1 / (2 ^ attacker.protectStreak)
    if math.random() < chance then
      attacker.protectedThisTurn = true
      attacker.protectStreak = attacker.protectStreak + 1
      table.insert(log, attacker.name .. " se protegeu!")
    else
      attacker.protectStreak = 0
      table.insert(log, attacker.name .. " tentou se proteger, mas falhou!")
    end
    return
  else
    attacker.protectStreak = 0
  end

  if defender.charging and defender.chargeMove and (defender.chargeMove.name == "Dig" or defender.chargeMove.name == "Fly" or defender.chargeMove.name == "Bounce") then
    local bypass = false
    if defender.chargeMove.name == "Dig" and (move.name == "Earthquake" or move.name == "Magnitude") then bypass = true end
    if defender.chargeMove.name == "Fly" or defender.chargeMove.name == "Bounce" then
      if move.name == "Gust" or move.name == "Twister" or move.name == "Thunder" or move.name == "Sky Uppercut" then bypass = true end
    end
    if not bypass then
      table.insert(log, defender.name .. " está fora de alcance!")
      return
    end
  end

  -- Alguns golpes têm condição de uso própria.
  if move.name == "Dream Eater" and defender.status ~= "Sleep" then
    table.insert(log, attacker.name .. " não pode usar Dream Eater porque " .. defender.name .. " não está dormindo!")
    return
  end
  if move.name == "Snore" and attacker.status ~= "Sleep" then
    table.insert(log, attacker.name .. " não pode usar Snore porque não está dormindo!")
    return
  end

  if move.name == "Fake Out" and not attacker.firstTurn then
    table.insert(log, attacker.name .. " não pode usar Fake Out agora!")
    return
  end
  attacker.firstTurn = false

  local soundMoveNames = { ["Roar"]=true, ["Supersonic"]=true, ["Screech"]=true, ["Sing"]=true, ["Snore"]=true, ["Uproar"]=true, ["Hyper Voice"]=true, ["Metal Sound"]=true, ["Perish Song"]=true, ["Heal Bell"]=true, ["Grass Whistle"]=true, ["Howl"]=true }
  if hasAbility(defender, "Soundproof") and soundMoveNames[move.name] then
    table.insert(log, defender.name .. " está protegido por Soundproof contra " .. move.name .. "!")
    return
  end

  if move.accuracy then
    local baseAccuracy = move.accuracy
    if move.name == "Guillotine" or move.name == "Horn Drill" or move.name == "Fissure" or move.name == "Sheer Cold" then
      if attacker.level < defender.level then
        table.insert(log, attacker.name .. " usou " .. move.name .. ", mas o alvo tem nível maior!")
        return
      end
      baseAccuracy = math.min(100, 30 + attacker.level - defender.level)
    end
    if move.name == "Thunder" and b.weather and b.weather.kind == "rain" then baseAccuracy = 100 end
    if move.name == "Thunder" and b.weather and b.weather.kind == "sun" then baseAccuracy = 50 end
    if move.name == "Blizzard" and b.weather and b.weather.kind == "hail" then baseAccuracy = 100 end
    local acc = baseAccuracy * accuracyStageMultiplier(ensureBattleStages(attacker).acc)
    local eva = accuracyStageMultiplier(ensureBattleStages(defender).eva)
    if defender.foresight and (move.type == "Normal" or move.type == "Fighting") then eva = 1 end
    local finalAcc = math.max(1, math.min(100, acc / eva))
    if hasAbility(attacker, "Compound Eyes") then finalAcc = math.min(100, finalAcc * 1.3) end
    if hasAbility(attacker, "Hustle") and move.category == "physical" then finalAcc = finalAcc * 0.8 end
    if hasAbility(defender, "Sand Veil") and b.weather and b.weather.kind == "sandstorm" then finalAcc = finalAcc * 0.8 end
    if defender.heldItem == "BrightPowder" then finalAcc = finalAcc * 0.9 end
    if math.random(1, 10000) > math.floor(finalAcc * 100) then
      table.insert(log, attacker.name .. " usou " .. move.name .. ", mas errou!")
      -- Jump Kick / High Jump Kick causam dano de recuo quando erram.
      if move.name == "Jump Kick" or move.name == "High Jump Kick" or move.name == "Hi Jump Kick" then
        local recoil = math.max(1, math.floor(attacker.maxHp / 2))
        attacker.hp = math.max(0, attacker.hp - recoil)
        table.insert(log, attacker.name .. " sofreu " .. recoil .. " de dano de recuo!")
      end
      return
    end
  end

  if (move.name == "Explosion" or move.name == "Self-Destruct" or move.name == "Selfdestruct") and (hasAbility(defender,"Damp") or hasAbility(attacker,"Damp")) then
    table.insert(log, defender.name .. " anulou " .. move.name .. " com Damp!")
    return
  end
  table.insert(log, attacker.name .. " usou " .. move.name .. "!")
  if move.power == nil and move.desc and move.desc ~= "" then
    table.insert(log, translateMoveDesc(move.desc))
  end

  if defender.protectedThisTurn then
    table.insert(log, defender.name .. " se protegeu do ataque!")
    attacker.presentPower = nil
    return
  end

  if move.name == "Present" then
    if math.random(1,100) <= 20 then
      local heal = math.max(1, math.floor(defender.maxHp / 4)); local before = defender.hp
      defender.hp = math.min(defender.maxHp, defender.hp + heal)
      table.insert(log, defender.name .. " recuperou " .. (defender.hp-before) .. " HP com Present!")
      return
    end
    local r = math.random(1,100)
    attacker.presentPower = (r <= 50 and 40) or (r <= 87 and 80) or 120
  end

  local weatherKey = nil
  for k, wname in pairs(WEATHER_SETTERS) do
    if MOVES[k] == move then weatherKey = wname break end
  end
  if weatherKey then
    b.weather = { kind = weatherKey, turnsLeft = WEATHER_DURATION }
    table.insert(log, WEATHER_LABEL[weatherKey])
    return
  end

  if move.isLeechSeed then
    if defender.types[1] == "Grass" or defender.types[2] == "Grass" then
      table.insert(log, defender.name .. " é imune a Leech Seed por ser do tipo Grass!")
    elseif defender.seeded then
      table.insert(log, defender.name .. " já está com Leech Seed.")
    else
      defender.seeded = true
      table.insert(log, defender.name .. " foi plantado com Leech Seed!")
    end
    return
  end

  -- Condições de dano especiais antes da fórmula principal.
  if move.name == "Superpower" then
    attacker._selfStatDrop=true; changeStatStage(attacker, "atk", -1, log); changeStatStage(attacker, "def", -1, log); attacker._selfStatDrop=nil
  elseif move.name == "Leaf Blade" then
    -- Leaf Blade has high critical-hit ratio in Gen III.
  elseif move.name == "Aerial Ace" or move.name == "Swift" or move.name == "Shock Wave" then
    -- These moves bypass normal accuracy/evasion checks; their accuracy was handled above.
  end

  -- Dano fixo e golpes de efeito especial da Gen 3.
  local fixedDamage = getFixedDamage(attacker, defender, move)
  local totalDamage = 0
  if fixedDamage ~= nil then
    if fixedDamage <= 0 then
      table.insert(log, attacker.name .. " não conseguiu causar dano com " .. move.name .. ".")
    else
      if defender.substituteHp and defender.substituteHp > 0 then
        defender.hitSubstituteThisTurn = true
        defender.substituteHp = defender.substituteHp - fixedDamage
        if defender.substituteHp <= 0 then defender.substituteHp = 0; table.insert(log, defender.name .. " perdeu o Substitute!") end
      else
        defender.hp = math.max(0, defender.hp - fixedDamage)
      end
      defender.lastDamageTaken = fixedDamage
      defender.tookDamageThisTurn = true
      defender.lastDamageCategory = move.category
      if defender.bideTurns and defender.bideTurns > 0 then defender.bideDamage = (defender.bideDamage or 0) + fixedDamage end
      table.insert(log, "Dano: " .. fixedDamage)
    end
  else
    local hits = 1
    if move.desc and move.desc:match("Hits 2%-5 times") then
      hits = rollMultiHitCount(move)
    elseif move.desc and move.desc:match("Hits twice") then
      hits = 2
    end

    local firstEff = 1
    for hit = 1, hits do
      if defender.hp <= 0 then break end
      local dmg, isCrit, typeEff = calculateDamage(attacker, defender, move, b.weather)
      firstEff = typeEff
      totalDamage = totalDamage + dmg
      if dmg > 0 then
        local actualDamage = dmg
        if defender.hp - actualDamage <= 0 and defender.hp > 1 and (defender.heldItem == "FocusBand") and math.random(1,100) <= 10 then
          actualDamage = defender.hp - 1
          table.insert(log, defender.name .. " resistiu com 1 HP!")
        end
        if defender.substituteHp and defender.substituteHp > 0 then
          defender.hitSubstituteThisTurn = true
          defender.substituteHp = defender.substituteHp - actualDamage
          if defender.substituteHp <= 0 then defender.substituteHp = 0; table.insert(log, defender.name .. " perdeu o Substitute!") end
        else
          defender.hp = math.max(0, defender.hp - actualDamage)
        end
        defender.lastDamageTaken = actualDamage
        defender.tookDamageThisTurn = true
        defender.lastDamageCategory = move.category
        if defender.bideTurns and defender.bideTurns > 0 then defender.bideDamage = (defender.bideDamage or 0) + dmg end
        if isCrit then table.insert(log, "Foi um golpe crítico!") end
      end
    end
    if hits > 1 then table.insert(log, "Acertou " .. hits .. " vezes! Dano total: " .. totalDamage) end
    if totalDamage > 0 and hits == 1 then table.insert(log, "Dano: " .. totalDamage) end
    if firstEff > 1 then table.insert(log, "É super efetivo!") end
    if firstEff < 1 and firstEff > 0 then table.insert(log, "Não é muito eficaz...") end
    if firstEff == 0 then table.insert(log, "Não afetou " .. defender.name .. "...") end

    if move.name == "False Swipe" and defender.hp <= 0 then defender.hp = 1 end
  end

  if move.name == "Counter" or move.name == "Mirror Coat" then
    if fixedDamage and fixedDamage > 0 then table.insert(log, "Dano: " .. fixedDamage) end
  end

  if defender.hp < defender.maxHp and defender.rage and not defender.hitSubstituteThisTurn then
    changeStatStage(defender, "atk", 1, log)
  end

  if attacker.hp <= 0 and attacker.endureThisTurn then
    attacker.hp = 1
    table.insert(log, attacker.name .. " resistiu com 1 HP!")
  end
  if defender.hp <= 0 and defender.endureThisTurn then
    defender.hp = 1
    table.insert(log, defender.name .. " resistiu com 1 HP!")
  end

  -- Efeitos secundários são aplicados somente quando o golpe acertou.
  local hit = (move.power == nil) or (fixedDamage ~= nil and fixedDamage > 0) or (fixedDamage == nil and totalDamage > 0)
  if hit and (move.name == "Hyper Beam") then attacker.rechargeTurns = 1 end
  if hit and (move.name == "Thrash" or move.name == "Outrage" or move.name == "Petal Dance") and attacker.rampageTurns <= 0 then
    attacker.rampageTurns = math.random(1,2)
    attacker.rampageMove = move
  end
  applyMoveSpecialEffects(b, attacker, defender, move, totalDamage or fixedDamage or 0, hit, log)
  if move.name == "Struggle" and hit and (totalDamage or 0) > 0 then
    local recoil = math.max(1, math.floor((attacker.maxHp or 1) / 4))
    attacker.hp = math.max(0, attacker.hp - recoil)
    table.insert(log, attacker.name .. " sofreu " .. recoil .. " de dano de recuo de Struggle!")
  end
  attacker.presentPower = nil

  if defender.hp <= 0 and defender.destinyBond then
    attacker.hp = 0
    defender.destinyBond = false
    table.insert(log, attacker.name .. " desmaiou junto por causa de Destiny Bond!")
  end
  if attacker.hp <= 0 and attacker.grudge and defender.lastMoveName then
    for i, m in ipairs(defender.moves or {}) do
      if m.name == defender.lastMoveName then defender.pp[i] = 0; break end
    end
    table.insert(log, defender.name .. " perdeu todo o PP de " .. defender.lastMoveName .. " por causa de Grudge!")
    attacker.grudge = false
  end

  -- Recuo dos golpes que possuem drainPercent negativo.
  if hit and attacker.heldItem == "ShellBell" and (totalDamage or 0) > 0 then
    local heal=math.max(1,math.floor((totalDamage or 0)/8)); attacker.hp=math.min(attacker.maxHp,attacker.hp+heal)
  end
  if hit and move.drainPercent and move.drainPercent < 0 and (totalDamage or 0) > 0 and not hasAbility(attacker, "Rock Head") then
    local recoil = math.max(1, math.floor((totalDamage or 0) * math.abs(move.drainPercent) / 100))
    attacker.hp = math.max(0, attacker.hp - recoil)
    table.insert(log, attacker.name .. " sofreu " .. recoil .. " de dano de recuo!")
  end
end

-- ---- batalha selvagem ----

function resolveRound(playerName, playerMoveIndex)
  local b = battles[playerName]
  local log = {}
  b.player.protectedThisTurn = false
  b.enemy.protectedThisTurn = false
  b.player.flinched = false
  b.enemy.flinched = false
  b.player.actedThisTurn = false
  b.enemy.actedThisTurn = false
  b.player.tookDamageThisTurn = false
  b.enemy.tookDamageThisTurn = false
  b.player.lastDamageTaken = 0
  b.enemy.lastDamageTaken = 0
  b.player.lastDamageCategory = nil
  b.enemy.lastDamageCategory = nil
  b.player.endureThisTurn = false
  b.enemy.endureThisTurn = false
  b.player.hitSubstituteThisTurn = false
  b.enemy.hitSubstituteThisTurn = false
  b.player.actedThisTurn = false
  b.enemy.actedThisTurn = false
  b.player.tookDamageThisTurn = false
  b.enemy.tookDamageThisTurn = false
  b.player.lastDamageTaken = 0
  b.enemy.lastDamageTaken = 0
  b.player.lastDamageCategory = nil
  b.enemy.lastDamageCategory = nil
  b.player.endureThisTurn = false
  b.enemy.endureThisTurn = false
  b.player.hitSubstituteThisTurn = false
  b.enemy.hitSubstituteThisTurn = false

  local enemyMoveIndex = chooseEnemyMoveIndex(b.enemy)
  local actions = {
    { who="player", idx=playerMoveIndex, move=b.player.moves[playerMoveIndex] },
    { who="enemy",  idx=enemyMoveIndex,  move=b.enemy.moves[enemyMoveIndex] },
  }
  table.sort(actions, function(a, c)
    local pa, pc = a.move.priority or 0, c.move.priority or 0
    if pa ~= pc then return pa > pc end
    local sa = getBattleSpeed(a.who=="player" and b.player or b.enemy, b.weather)
    local sc = getBattleSpeed(c.who=="player" and b.player or b.enemy, b.weather)
    if sa == sc then return math.random() < 0.5 end
    return sa > sc
  end)

  for _, act in ipairs(actions) do
    local otherWho = (act.who == "player") and "enemy" or "player"
    resolveMove(b, act.who, otherWho, act.idx, log)
    if b.player.hp <= 0 or b.enemy.hp <= 0 then break end
  end

  if b.player.batonPass and b.player.hp > 0 then
    b.player.batonPass=nil; b.phase="switch"; b.forcedSwitch=true; drawBattleSwitchMenu(playerName,b,true); b.log=table.concat(log,"<br>") .. "<br>Baton Pass: escolha o Pokémon que entrará."; renderAll(playerName); return
  end
  if b.player.hp > 0 and b.enemy.hp > 0 then
    applyEndOfTurnStatus(b.player, log, b.weather)
    applyEndOfTurnStatus(b.enemy, log, b.weather)
    if b.player.seeded then applyLeechSeed(b.player, b.enemy, log) end
    if b.enemy.seeded then applyLeechSeed(b.enemy, b.player, log) end
    resolveFutureSight(b.player, log)
    resolveFutureSight(b.enemy, log)
    if b.weather then
      applyWeatherTick(b.player, b.weather, log)
      applyWeatherTick(b.enemy, b.weather, log)
      b.weather.turnsLeft = b.weather.turnsLeft - 1
      if b.weather.turnsLeft <= 0 then table.insert(log, "O clima voltou ao normal."); b.weather = nil end
    end
  end

  b.log = table.concat(log, "<br>")
  b.phase = "menu"

  if b.forceEndBattle then
    b.log = table.concat(log, "<br>") .. "<br>A batalha terminou!"
    b.phase = "finished"
    b.resultTitle = "BATALHA ENCERRADA"
    b.resultMessage = "O Pokémon selvagem foi afastado."
    renderAll(playerName)
    return
  end

  if b.enemy.hp <= 0 then
    local xpLog = awardVictoryXp(playerName, b.player, b.enemy, false)
    b.log = b.log .. "<br>" .. b.enemy.name .. " desmaiou!<br>" .. xpLog
    b.phase = "finished"
    b.resultTitle = "VOCÊ VENCEU!"
    b.resultMessage = b.player.name .. " venceu a batalha!<br>" .. xpLog
  elseif b.player.hp <= 0 then
    b.log = b.log .. "<br>" .. b.player.name .. " desmaiou!"
    if hasUsablePokemon(playerName) then
      b.phase = "switch"
      b.forcedSwitch = true
      drawBattleSwitchMenu(playerName, b, true)
    else
      b.log = b.log .. "<br>Todos os seus Pokémon desmaiaram!"
      b.phase = "finished"
      b.resultTitle = "VOCÊ PERDEU!"
      b.resultMessage = "Todos os seus Pokémon desmaiaram.<br>Você pode voltar ao Centro Pokémon."
    end
  end

  renderAll(playerName)
end

