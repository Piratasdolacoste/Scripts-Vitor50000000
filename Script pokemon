local function switchPvpPokemon(id, playerName, newIndex, log)
  local b = pvpBattles[id]
  local team = playerTeams[playerName] or {}
  local p = team[newIndex]
  if not b or not p or p.hp <= 0 then return false end
  local isA = (playerName == b.nameA)
  local old = isA and b.player or b.enemy
  if p == old then return false end
  old.flashFire = nil -- o bônus de Flash Fire termina ao sair de campo
  restoreTransformedPokemon(old)
  old.seeded = false
  old.protectedThisTurn = false
  p.seeded = false
  p.protectedThisTurn = false
  p.protectStreak = 0
  activeIndex[playerName] = newIndex
  resetBattleStages(p)
  if hasAbility(old, "Natural Cure") and old.status then old.status=nil; old.toxicCounter=0; table.insert(log, old.name .. " foi curado por Natural Cure!") end
  if isA then b.player = p else b.enemy = p end
  applySpikesOnEntry(b, isA and "player" or "enemy", p, log)
  if p.hp > 0 then applyAbilityOnSwitch(p, isA and b.enemy or b.player, log) end
  table.insert(log, playerName .. " enviou " .. p.name .. "!")
  drawPvpSprites(id)
  return true
end

